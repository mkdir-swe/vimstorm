@scenario("stop", "stop --card's sessions and end its Factory run (--card 0: every session)")
def sc_stop(d, rig, o):
    cards = {x["card"] for x in sessions(d, rig)} if o.card == 0 else {o.card}
    for c in cards:
        stop_card(d, rig, c)
    print("stopped", ", ".join(map(str, sorted(c for c in cards if c is not None))) or "nothing")


@scenario("board-down", "the fake Azure DevOps stops (an outage; reseed brings it back on the same port)")
def sc_board_down(d, rig, o):
    if not alive(rig.get("ado_pgid", 0)):
        print("the board is down already")
        return
    os.killpg(rig["ado_pgid"], signal.SIGTERM)
    wait_for(lambda: not alive(rig["ado_pgid"]), 10, "the fake Azure DevOps to stop")
    print(f"board down (port {rig['ado_port']})")


@scenario("reseed", "the board starts over from its seed (the fake Azure DevOps restarted on the same port)")
def sc_reseed(d, rig, o):
    if alive(rig.get("ado_pgid", 0)):
        os.killpg(rig["ado_pgid"], signal.SIGTERM)
        wait_for(lambda: not alive(rig["ado_pgid"]), 10, "the old fake Azure DevOps to stop")
    log = d / "logs/ado.log"
    log.write_text("")
    rig["ado_pgid"] = daemon(
        ["bun", FAKE_ADO, "--port", rig["ado_port"], "--seed", rig["seed"], "--log", d / "logs/ado-requests.log"],
        log,
        abe_env(d, rig),
    )
    save(d, rig)
    wait_for(lambda: "fake Azure DevOps on" in log.read_text(), 15, "the fake Azure DevOps")
    print(log.read_text().strip().splitlines()[0])


def ec2_change(d, fn):
    """Changes the fake EC2's state under its lock, as its `aws` does (fake-ec2/state.ts)."""
    lock = d / "bin/state.lock"
    end = time.time() + 10
    while True:
        try:
            lock.mkdir()
            break
        except FileExistsError:
            if time.time() > end:
                shutil.rmtree(lock, ignore_errors=True)
            time.sleep(0.01)
    try:
        f = d / "bin/state.json"
        st = json.loads(f.read_text())
        fn(st)
        tmp = f.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(st))
        os.replace(tmp, f)
    finally:
        shutil.rmtree(lock, ignore_errors=True)


@scenario("box", "put a box --box (qa-1) of yours in --state (pending|running|stopping|stopped; default pending), --held keeps it there (else pending → running after 20 s, stopping → stopped after 8 s); --card ties it to a card, --repo owner/name to a repo (qa-rig/demo-shop). Then film the Boxes tab ({@super+6})")
def sc_box(d, rig, o):
    name, state = o.box or "qa-1", o.state or "pending"
    now = int(time.time() * 1000)

    def put(st):
        tags = [
            {"Key": "abe:owner", "Value": st["owner"]},
            {"Key": "abe:box", "Value": name},
            {"Key": "abe:team", "Value": "qa"},
            {"Key": "abe:repo", "Value": o.repo or DEMO_REPO},
            {"Key": "abe:card", "Value": str(o.card)},
            {"Key": "Name", "Value": name},
        ]
        for i in st["instances"]:
            if any(t["Key"] == "abe:box" and t["Value"] == name for t in i["Tags"]):
                i.update({"State": state, "since": now, "held": o.held, "Tags": tags})
                return
        n = st["next"]
        st["next"] = n + 1
        st["instances"].append(
            {
                "InstanceId": f"i-0qa{n:014x}",
                "InstanceType": "m8g.xlarge",
                "State": state,
                "since": now,
                "launchedAt": now,
                "held": o.held,
                "PrivateIpAddress": f"10.40.0.{n}",
                "Tags": tags,
                "profile": f"abe-box-{st['owner']}-boxes",
            }
        )

    ec2_change(d, put)
    print(f"box {name}: {state}{' (held)' if o.held else ''}, repo {o.repo or DEMO_REPO}")


@scenario("box-gone", "take every fake box away (--box: only that one)")
def sc_box_gone(d, rig, o):
    def drop(st):
        st["instances"] = [
            i for i in st["instances"] if o.box and not any(t["Key"] == "abe:box" and t["Value"] == o.box for t in i["Tags"])
        ]

    ec2_change(d, drop)
    print("boxes gone" if not o.box else f"box {o.box} gone")


# GitHub Actions for the Pipelines tab: the env's fake gh answers from gh/runs.json (qarig_gh.py).
WORKFLOWS = {"CI": ("ci.yml", 81234567, 1180), "Deploy Dev": ("deploy-dev.yml", 81234590, 307), "Deploy Test": ("deploy-test.yml", 81234611, 92), "Deploy Prod": ("deploy-prod.yml", 81234633, 40)}
BRANCHES = [
    ("feature/AB-1234-checkout-total-reads-the-market-table-instead-of-a-per-market-value", "pull_request", "Checkout total reads the market table instead of a per-market value"),
    ("fix/AB-17-signin-email", "pull_request", "Sign-in accepts a plus address"),
    ("main", "push", "Merge pull request #212 from qa-rig/fix/AB-17-signin-email"),
    ("copilot/fix-cart-rounding-when-a-market-has-no-currency-decimals", "pull_request", "Fix cart rounding when a market has no currency decimals"),
    ("feature/AB-4-cart-total", "pull_request", "Cart total"),
    ("dependabot/npm_and_yarn/vite-5.4.11", "pull_request", "Bump vite from 5.4.10 to 5.4.11"),
    ("main", "push", "Cart total reads prices in cents"),
    ("me/try", "push", "wip"),
]


def pipeline_runs(n, now_ms):
    """n runs newest first: the newest running, the next failed, one cancelled, the rest passed;
    ids far from the run numbers (each workflow counts its own), branches short and long; over 30, the
    oldest a Deploy Prod by hand."""
    import hashlib

    counters = {w: c for w, (_, _, c) in WORKFLOWS.items()}
    runs = []
    for i in range(n):
        branch, event, title = BRANCHES[i % len(BRANCHES)]
        workflow = "CI"
        if i % 3 == 2 and i > 1:
            workflow, branch, event, title = "Deploy Dev", "main", "push", "Cart total reads prices in cents"
        if i % 7 == 6:
            workflow, branch, event, title = "Deploy Test", "release/2026.10", "workflow_dispatch", "Deploy Test"
        if i == 9:
            branch, event, title = "main", "schedule", "Nightly"
        if i == n - 1 and n > 30:  # prod deployed by hand before the newest 30: only Deploys shows it
            workflow, branch, event, title = "Deploy Prod", "main", "workflow_dispatch", "Release rc-41"
        file, wid, _ = WORKFLOWS[workflow]
        created = now_ms - i * 23 * 60_000 - 40_000
        started = created + 8_000
        state = "running" if i == 0 else "failed" if i == 1 else "cancelled" if i == 4 else "passed"
        rid = 9_026_000_000 + (n - i) * 7_919
        keys = [("build", "Build", []), ("lint", "Lint", []), ("test", "Test", ["build"])] if workflow == "CI" else [("build", "Build", []), ("deploy", f"Deploy to {workflow.split()[-1].lower()}", ["build"])]
        jobs = []
        t = started
        for k, (key, name, needs) in enumerate(keys):
            last = k == len(keys) - 1
            steps = []
            for sn in ("Set up job", "Checkout", "Install", name, "Complete job"):
                steps.append({"name": sn, "status": "completed", "conclusion": "success", "started": t, "completed": t + 20_000})
                t += 20_000
            j = {"id": 51_000_000_000 + rid % 1_000_000 * 10 + k, "key": key, "name": name, "needs": needs, "status": "completed", "conclusion": "success", "started": steps[0]["started"], "completed": steps[-1]["completed"], "steps": steps}
            if last and state != "passed":
                j["steps"][3].update(status="in_progress" if state == "running" else "completed", conclusion={"running": None, "failed": "failure", "cancelled": "cancelled"}[state], completed=None if state == "running" else j["steps"][3]["completed"])
                j["steps"][4].update(status="queued" if state == "running" else "completed", conclusion=None if state == "running" else "skipped", started=None if state == "running" else j["steps"][4]["started"], completed=None if state == "running" else j["steps"][4]["completed"])
                j.update(status="in_progress" if state == "running" else "completed", conclusion={"running": None, "failed": "failure", "cancelled": "cancelled"}[state], completed=None if state == "running" else j["completed"])
            jobs.append(j)
        if state == "running":  # started 90 s ago, its last job at its test step
            shift = (now_ms - 90_000) - started
            for j in jobs:
                for x in [j, *j["steps"]]:
                    for f in ("started", "completed"):
                        if x.get(f) is not None:
                            x[f] = min(x[f] + shift, now_ms - 1_000)
            started += shift
            created += shift
        updated = max([x for j in jobs for x in (j["started"], j["completed"]) if x is not None] + [started])
        runs.append(
            {
                "id": rid,
                "number": 0,
                "workflow": workflow,
                "workflow_id": wid,
                "file": file,
                "title": title,
                "attempt": 2 if i == 3 else 1,
                "event": event,
                "status": "in_progress" if state == "running" else "completed",
                "conclusion": {"running": None, "failed": "failure", "cancelled": "cancelled", "passed": "success"}[state],
                "branch": branch,
                "sha": hashlib.sha1(f"qarig-run-{i}".encode()).hexdigest(),
                "created": created,
                "started": started,
                "updated": updated,
                "actor": "dependabot[bot]" if branch.startswith("dependabot/") else "sam-qa" if i % 5 == 3 else "alex",
                "pr": 200 + i % len(BRANCHES) if event == "pull_request" else None,
                "jobs": jobs,
            }
        )
    for r in reversed(runs):  # each workflow numbers its own runs, oldest first
        counters[r["workflow"]] += 1
        r["number"] = counters[r["workflow"]]
    return runs


@scenario("pipelines", "GitHub Actions runs for the Pipelines tab (--runs 40; 0: none again): the env's fake gh answers them for any repo, `gh api user` says alex; the newest runs, the next failed, one cancelled; ids unlike run numbers; long and short branches. Cancel / rerun change them")
def sc_pipelines(d, rig, o):
    install_gh(d)  # an env made before the scenario had a gh that knows no runs
    f = d / "gh/runs.json"
    if o.runs <= 0:
        f.unlink(missing_ok=True)
        print("pipelines: no runs")
        return
    runs = pipeline_runs(o.runs, int(time.time() * 1000))
    write(f, json.dumps({"me": "alex", "runs": runs}, indent=1) + "\n")
    origin = subprocess.run(["git", "-C", rig["path"], "config", "--get", "remote.origin.url"], capture_output=True, text=True).stdout.strip()
    print(f"pipelines: {len(runs)} runs (#{runs[0]['number']} id {runs[0]['id']} running, #{runs[1]['number']} failed) in {f}; the repo's origin {origin or 'none'}")


def cmd_diff(a):
    qarig_diff.run(a)


def cmd_scenario(a):
    d = env_dir(a.name)
    if a.scenario == "list":
        for k, (_, h) in SCENARIOS.items():
            print(f"{k:16} {h}")
        return
    if a.scenario not in SCENARIOS:
        die(f"no scenario {a.scenario}: qarig scenario {a.name} list")
    rig = load(d)
    if a.after is None:
        a.after = {"needs-you": 3000, "working": 60000}.get(a.scenario, 0)
    t0 = time.time()
    SCENARIOS[a.scenario][0](d, rig, a)
    qarig_drive.log(d, "scenario", a.scenario, {"ok": True}, int((time.time() - t0) * 1000))


# ---------------------------------------------------------------- shot


def link_plugins(d):
    real = Path(pwd.getpwuid(os.getuid()).pw_dir) / ".local/share/vimstorm"
    link = d / "home/.local/share/vimstorm"
    if real.exists() and not link.exists():
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(real)


def build_lock(exclusive):
    """The shared build's lock: shots hold it shared, rebuild exclusive (the binary reads its nvim
    config and the fakes from the build's checkout, which rebuild moves)."""
    RIG.mkdir(parents=True, exist_ok=True)
    f = open(RIG / "build.flock", "a")
    if exclusive:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("qarig: waiting for running shots / another rebuild", file=sys.stderr)
            fcntl.flock(f, fcntl.LOCK_EX)
    else:
        try:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            print("qarig: a rebuild runs; the shot waits for it", file=sys.stderr)
            fcntl.flock(f, fcntl.LOCK_SH)
    return f


def check_label(label):
    if not label or "/" in label or label.startswith(".") or not all(c.isalnum() or c in "-_." for c in label):
        die(f"bad label {label!r}: letters, digits, - _ . only")


# ---------------------------------------------------------------- the real HOME guard

REAL_HOME = pwd.getpwuid(os.getuid()).pw_dir
SERVE_KEYS = ("HOME", "ABE_STATE_DIR", "ABE_SOCKET", "QARIG_NAME", "VIMSTORM_SHOT")


def parse_serves(ps_text):
    """`ps -axwwE -o pid=,command=` -> {pid: {"argv": [...], <SERVE_KEYS>: value}} for every
    `abe serve` (not qarig's `/bin/sh` wrapper). Only those keys are kept: the rest of a process's
    env (tokens) never leaves this function."""
    found = {}
    for line in ps_text.splitlines():
        parts = line.split()
        if len(parts) < 3 or not parts[0].isdigit():
            continue
        words = parts[1:]
        n = next((i for i, w in enumerate(words) if i > 0 and "=" in w and (w.split("=", 1)[0].replace("_", "a").isalnum())), len(words))
        argv, env = words[:n], words[n:]
        if not argv or argv[-1] != "serve" or argv[0] in ("/bin/sh", "sh"):
            continue
        if not any("abe" in w or w.endswith("main.ts") for w in argv[:-1]):
            continue
        kept = {"argv": argv}
        for w in env:
            k, _, v = w.partition("=")
            if k in SERVE_KEYS:
                kept[k] = v
        found[int(parts[0])] = kept
    return found


def serves():
    out = subprocess.run(["ps", "-axwwE", "-o", "pid=,command="], capture_output=True, text=True).stdout
    return parse_serves(out)


def env_serves(d):
    """The serves on env d's state or socket."""
    return {pid: x for pid, x in serves().items() if x.get("ABE_STATE_DIR") == str(d / "s") or x.get("ABE_SOCKET") == str(d / "s/s.sock")}


def stray_serves(before, after, d, png, home=None):
    """The serves in `after` and not `before` that are not this env's: under the real HOME (your
    Abe state), or started by this shot (its QARIG_NAME / VIMSTORM_SHOT) on any HOME but the env's.
    The env's own serve (its state, under `home`: serve_home) is none of them."""
    home = home or str(d / "home")
    bad = []
    for pid, x in sorted(after.items()):
        if pid in before or (x.get("ABE_STATE_DIR") == str(d / "s") and x.get("HOME") == home):
            continue
        mine = x.get("QARIG_NAME") == d.name or x.get("VIMSTORM_SHOT") == str(png)
        if x.get("HOME") == REAL_HOME or (mine and x.get("HOME") != str(d / "home")):
            bad.append((pid, x, mine))
    return bad


def answers(sock):
    """Something listens on the unix socket (a stale file left by a dead serve does not)."""
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(1)
        try:
            s.connect(str(sock))
            return True
        except OSError:
            return False


def ensure_serve(d, rig):
    """The env's own serve answers before the app starts, so the app's bridge never has to start
    one; a serve on the env's socket under another HOME is refused."""
    for pid, x in serves().items():
        if (x.get("ABE_SOCKET") == str(d / "s/s.sock") or x.get("ABE_STATE_DIR") == str(d / "s")) and x.get("HOME") != serve_home(d, rig):
            die(
                f"env {d.name}'s socket is served by pid {pid} under HOME={x.get('HOME')}, not the env's: "
                f"a shot would read and write that HOME's Abe state. Not touched; stop it yourself if it is "
                f"yours, then qarig down {d.name} && qarig up {d.name}"
            )
    if answers(d / "s/s.sock"):
        return
    print(f"# {d.name}'s serve was not answering: starting it again (log {d / 'logs/serve.log'})", file=sys.stderr)
    (d / "s/s.sock").unlink(missing_ok=True)
    rig["serve_pgid"] = daemon([rig["abe_bin"], "serve"], d / "logs/serve.log", serve_env(d, rig), cwd=rig["path"])
    save(d, rig)
    wait_for(lambda: answers(d / "s/s.sock"), 20, f"{d.name}'s abe serve")


def cmd_shot(a):
    d = env_dir(a.name)
    check_label(a.label)
    if not (d / "rig.json").exists():
        die(f"no env {a.name}: qarig up {a.name} first (a shot always runs on an env)")
    rig = load(d)
    if not BIN.exists():
        die(f"no shared build at {BIN}: qarig rebuild")
    label = a.label
    shots = d / "shots" / label  # each label's PNGs, frames and flipbook in a folder of its own
    shutil.rmtree(shots, ignore_errors=True)
    shots.mkdir(parents=True)
    png = shots / f"{label}.png"
    env = abe_env(d, rig)
    # the app runs on the env's HOME too, so a serve its bridge starts is the env's; the plugins
    # come from the real ~/.local/share/vimstorm through a link
    link_plugins(d)
    keys = a.keys
    if a.abe:
        keys = "{@super+alt+a}{wait:%d}" % a.abe_wait + keys
    env.update(
        {
            "VIMSTORM_SHOT": str(png),
            "VIMSTORM_SHOT_STATE": str(d / "state" / label),
            "VIMSTORM_SHOT_KEYS": keys,
            "VIMSTORM_SHOT_DELAY_MS": str(a.delay),
            "VIMSTORM_WINDOW_SIZE": a.size,
        }
    )
    if a.frames:
        env["VIMSTORM_SHOT_FRAMES"] = str(a.frames)
        env["VIMSTORM_SHOT_EVERY_MS"] = str(a.every)
    shutil.rmtree(d / "state" / label, ignore_errors=True)
    path = str(Path(a.path).resolve()) if a.path else rig["path"]
    log = d / "logs" / f"shot-{label}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    ensure_serve(d, rig)
    lock = build_lock(False)
    t0 = time.time()
    before = serves()
    with open(log, "w") as out:
        p = subprocess.Popen([str(BIN), path], env=env, cwd=path, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        try:
            code = p.wait(timeout=a.timeout)
        except subprocess.TimeoutExpired:
            code = "timeout"
            try:
                os.killpg(p.pid, signal.SIGKILL)  # the app with its nvim, LSPs and bridge
            except ProcessLookupError:
                pass
    lock.close()
    took = time.time() - t0
    stray = stray_serves(before, serves(), d, png, serve_home(d, rig))
    if stray:
        for pid, x, mine in stray:
            print(
                f"qarig: STRAY SERVE pid {pid} ({' '.join(x['argv'])}) HOME={x.get('HOME')} "
                f"ABE_STATE_DIR={x.get('ABE_STATE_DIR', '-')} ABE_SOCKET={x.get('ABE_SOCKET', '-')}"
                + (" started by this shot" if mine else " appeared during this shot (another process's?)"),
                file=sys.stderr,
            )
        die(
            f"shot {label} FAILED: a new abe serve outside env {d.name} appeared while it ran (left running, "
            f"not touched: tell the coordinator, never kill it). Shots in {shots}, log {log}",
            3,
        )
    bad = [l for l in log.read_text(errors="replace").splitlines() if "shot: unknown key" in l]
    if bad:  # a key that names nothing: the film would show a screen nobody drove
        die("\n".join(l.split("] ", 1)[-1] for l in bad[:1]) + f"\n(log: {log})")
    made = sorted(shots.glob(f"{label}-*.png"))
    if png.exists():
        made.append(png)
    if not made:
        die(f"no PNG (exit {code}, {took:.1f}s); log: {log}")
    if (shots / f"{label}-frames.tsv").exists():
        print(flipbook(shots, label))
    for f in made:
        print(f)
    print(f"# {len(made)} png in {took:.1f}s, log {log}", file=sys.stderr)


def flipbook(shots, label):
    """`<label>.html` beside the frames: a slider over them with each frame's ms and the step
    played just before, and a contact sheet of them all below."""
    rows = []
    last_step = ""
    for line in (shots / f"{label}-frames.tsv").read_text().splitlines():
        parts = line.split("\t")
        if parts[0] == "step" and len(parts) >= 3:
            last_step = f"{parts[1]} ms {parts[2]}"
        elif parts[0] == "frame" and len(parts) >= 3:
            rows.append({"file": parts[1], "ms": int(parts[2]), "label": parts[3] if len(parts) > 3 else "", "step": last_step})
    data = json.dumps(rows)
    html = f"""<!doctype html><meta charset=utf-8><title>{label} frames</title>
<style>
:root{{color-scheme:dark}} body{{background:#1e1f22;color:#dfe1e5;font:13px -apple-system,sans-serif;margin:16px}}
#bar{{display:flex;gap:12px;align-items:center;position:sticky;top:0;background:#1e1f22;padding:6px 0}}
input[type=range]{{flex:1}} #view{{max-width:100%;border:1px solid #393b40}}
#sheet{{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-top:16px}}
#sheet figure{{margin:0;cursor:pointer}} #sheet img{{width:100%;border:1px solid #393b40}}
#sheet figcaption{{color:#8c8f94;font-size:11px}} .on img{{outline:2px solid #3574f0}}
</style>
<div id=bar><button id=prev>&larr;</button><input id=r type=range min=0 value=0><button id=next>&rarr;</button>
<button id=play>play</button><span id=info></span></div>
<img id=view><div id=sheet></div>
<script>
const F={data};const r=document.getElementById('r'),v=document.getElementById('view'),info=document.getElementById('info');
r.max=F.length-1;const sheet=document.getElementById('sheet');
F.forEach((f,i)=>{{const fig=document.createElement('figure');fig.innerHTML=`<img loading=lazy src="${{f.file}}"><figcaption>#${{i+1}} ${{f.ms}} ms ${{f.label}}</figcaption>`;fig.onclick=()=>show(i);sheet.appendChild(fig)}});
function show(i){{i=Math.max(0,Math.min(F.length-1,i));r.value=i;const f=F[i];v.src=f.file;
info.textContent=`#${{i+1}}/${{F.length}} · ${{f.ms}} ms`+(i?` (+${{f.ms-F[i-1].ms}})`:'')+(f.label?` · ${{f.label}}`:'')+(f.step?` · last step ${{f.step}}`:'');
[...sheet.children].forEach((c,j)=>c.classList.toggle('on',j==i))}}
r.oninput=()=>show(+r.value);prev.onclick=()=>show(+r.value-1);next.onclick=()=>show(+r.value+1);
let t=null;play.onclick=()=>{{if(t){{clearInterval(t);t=null;play.textContent='play';return}}play.textContent='stop';
t=setInterval(()=>show(+r.value+1>=F.length?0:+r.value+1),(F[1]?F[1].ms-F[0].ms:100))}};
document.onkeydown=e=>{{if(e.key=='ArrowLeft')show(+r.value-1);if(e.key=='ArrowRight')show(+r.value+1)}};show(0);
</script>
"""
    out = shots / f"{label}.html"
    out.write_text(html)
    return out


# ---------------------------------------------------------------- the live app (drive socket, #232)

LIVE_UP_SECS = 120


def live_sock(d):
    return d / "live.sock"  # short: a socket path is at most 104 bytes


def live_rig(name):
    d = env_dir(name)
    rig = load(d)
    if not alive(rig.get("live_pgid", 0)) or not qarig_drive.answers(live_sock(d)):
        die(f"no live app in {name}: qarig live {name}")
    return d, rig


def drive(d, request, timeout=120):
    try:
        return qarig_drive.ask(live_sock(d), request, timeout)
    except qarig_drive.DriveError as e:
        die(str(e))


def stop_live(d, rig):
    """Quits the env's live app (over its socket, else its process group)."""
    pgid = rig.get("live_pgid", 0)
    if not alive(pgid):
        return
    if qarig_drive.answers(live_sock(d)):
        try:
            qarig_drive.ask(live_sock(d), {"quit": True}, 10)
        except qarig_drive.DriveError:
            pass
        end = time.time() + 15
        while group_runs_more_than_its_sleep(pgid) and time.time() < end:
            time.sleep(0.2)
    if alive(pgid) and ours(pgid):
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    rig["live_pgid"] = 0
    save(d, rig)


def cmd_live(a):
    d = env_dir(a.name)
    rig = load(d)
    if alive(rig.get("live_pgid", 0)) and qarig_drive.answers(live_sock(d)):
        print(f"# {a.name}'s live app runs already (pid group {rig['live_pgid']}, {live_sock(d)})", file=sys.stderr)
        return
    if not BIN.exists():
        die(f"no shared build at {BIN}: qarig rebuild")
    ensure_serve(d, rig)
    link_plugins(d)
    state = d / "state/live"
    if not a.keep:  # --keep: what the last run left (open set, pages, sessions) for a restart
        shutil.rmtree(state, ignore_errors=True)
    live_sock(d).unlink(missing_ok=True)
    env = abe_env(d, rig)
    env.update(
        {
            "VIMSTORM_DRIVE": str(live_sock(d)),
            "VIMSTORM_SHOT_STATE": str(state),
            "VIMSTORM_WINDOW_SIZE": a.size,
            "VIMSTORM_DRIVE_FPS": str(a.fps),
        }
    )
    path = str(Path(a.path).resolve()) if a.path else rig["path"]
    log = d / "logs/live.log"
    log.write_text("")
    # --no-path: as the Dock launches it (no path, cwd /): the open set at the last quit, else Welcome
    argv, cwd = ([BIN], "/") if a.no_path else ([BIN, path], path)
    rig["live_pgid"] = daemon(argv, log, env, cwd=cwd)
    rig["live_path"] = path
    rig["live_bin"] = str(BIN)  # rebuild waits only for the live apps of its own build
    save(d, rig)
    t0 = time.time()
    end = t0 + LIVE_UP_SECS
    while not qarig_drive.answers(live_sock(d)):
        if not alive(rig["live_pgid"]) or time.time() > end:
            tail = "\n".join(log.read_text(errors="replace").splitlines()[-15:])
            stop_live(d, rig)
            die(f"the live app did not come up ({time.time() - t0:.0f}s); log {log}:\n{tail}")
        time.sleep(0.2)
    if a.abe:
        drive(d, {"keys": "{@super+alt+a}"})
        drive(d, {"wait": {"text": "factory", "in": "view", "ms": 10_000}})
    qarig_drive.log(d, "live", "(no path)" if a.no_path else path, {"ok": True}, int((time.time() - t0) * 1000))
    print(f"live {a.name}: pid group {rig['live_pgid']}, socket {live_sock(d)}, up in {time.time() - t0:.1f}s")


def cmd_do(a):
    d, rig = live_rig(a.name)
    given = [x for x in (a.keys, a.type, a.click) if x]
    if len(given) != 1:
        die("do takes one of: '<keys>', --type '<text>', --click x,y")
    if a.type:
        ans = type_slowly(d, a.type, a.key_ms / 1000, a.timeout)
        qarig_drive.log(d, "do", f"type:{a.type}", ans, ans.get("ms", 0))
        if not ans.get("ok"):
            die(f"refused: {ans.get('error')}", 2)
        print(f"ok {ans.get('ms', 0)} ms")
        return
    if a.click:
        try:
            x, y = (float(v) for v in a.click.split(","))
        except ValueError:
            die(f"--click is x,y in logical px, not {a.click!r}")
        req, arg = {"click": [x, y]}, f"click:{a.click}"
    else:
        req, arg = {"keys": a.keys}, a.keys
    ans = drive(d, req, timeout=a.timeout)
    qarig_drive.log(d, "do", arg, ans, ans.get("ms", 0))
    if not ans.get("ok"):
        die(f"refused: {ans.get('error')}", 2)
    print(f"ok {ans.get('ms', 0)} ms")


def type_slowly(d, text, pause, timeout, ask=None):
    """`text` a key at a time, `pause` s apart: a picker's or filter's field takes each before the
    next (all at once, the hidden window's 10 frames a second dropped some: "hello" came out "heo").
    The first refusal stops it; the answer's ms are the whole text's."""
    ask = ask or (lambda req: drive(d, req, timeout=timeout))
    t0 = time.time()
    for i, c in enumerate(text):
        ans = ask({"type": c})
        if not ans.get("ok"):
            return ans
        if i < len(text) - 1:
            time.sleep(pause)
    return {"ok": True, "ms": int((time.time() - t0) * 1000)}


def cmd_see(a):
    d, rig = live_rig(a.name)
    for p in a.parts:
        if p not in qarig_drive.PARTS:
            die(f"no part {p!r}: {', '.join(qarig_drive.PARTS)}")
    ans = drive(d, {"see": list(a.parts)})
    if not ans.get("ok"):
        die(f"refused: {ans.get('error')}")
    print(json.dumps(ans, indent=1, ensure_ascii=False) if a.json else qarig_drive.seen_text(ans, a.parts), end="" if not a.json else "\n")


def timeout_evidence(d, rig, label, ans):
    """A timed-out wait's evidence: what was seen, a PNG, the serve log's tail."""
    out = d / "logs/timeouts" / f"{time.strftime('%H%M%S')}-{label}"
    out.mkdir(parents=True, exist_ok=True)
    (out / "trees.txt").write_text(qarig_drive.seen_text(ans))
    try:
        qarig_drive.ask(live_sock(d), {"shot": str(out / "snap.png")}, 30)
    except qarig_drive.DriveError:
        pass
    serve = d / "logs/serve.log"
    if serve.exists():
        (out / "serve-tail.log").write_text("\n".join(serve.read_text(errors="replace").splitlines()[-200:]) + "\n")
    return out


def cmd_wait(a):
    d, rig = live_rig(a.name)
    try:
        ms = qarig_drive.parse_ms(a.timeout)
    except ValueError as e:
        die(str(e))
    w = {"text": a.text, "ms": ms}
    if a.within:
        w["in"] = a.within
    if a.gone:
        w["gone"] = True
    ans = drive(d, {"wait": w}, timeout=ms / 1000 + 60)
    qarig_drive.log(d, "wait", f"{'gone ' if a.gone else ''}{a.text!r} in {a.within or 'any'}", ans, ans.get("ms", 0))
    if ans.get("ok"):
        print(f"ok {ans.get('ms', 0)} ms")
        return
    if ans.get("error") != "timeout":
        die(f"refused: {ans.get('error')}", 2)
    slug = "".join(c if c.isalnum() else "-" for c in a.text)[:30]
    out = timeout_evidence(d, rig, slug, ans)
    print(qarig_drive.seen_text(ans), end="", file=sys.stderr)
    die(f"timeout after {ans.get('ms')} ms waiting for {'no ' if a.gone else ''}{a.text!r} in {a.within or 'any part'}; evidence {out}")


def cmd_snap(a):
    check_label(a.label)
    d, rig = live_rig(a.name)
    png = d / "shots" / a.label / f"{a.label}.png"
    shutil.rmtree(png.parent, ignore_errors=True)
    ans = drive(d, {"shot": str(png)})
    qarig_drive.log(d, "snap", a.label, ans, ans.get("ms", 0))
    if not ans.get("ok"):
        die(f"snap failed: {ans.get('error')}")
    print(png)


def cmd_film(a):
    check_label(a.label)
    d, rig = live_rig(a.name)
    shots = d / "shots" / a.label
    shutil.rmtree(shots, ignore_errors=True)
    shots.mkdir(parents=True)
    png = shots / f"{a.label}.png"
    ans = drive(d, {"keys": a.keys, "film": {"to": str(png), "frames": a.frames, "every": a.every}}, timeout=a.timeout)
    qarig_drive.log(d, "film", a.keys, ans, ans.get("ms", 0))
    if not ans.get("ok"):
        die(f"refused: {ans.get('error')}", 2)
    if (shots / f"{a.label}-frames.tsv").exists():
        print(flipbook(shots, a.label))
    for f in sorted(shots.glob(f"{a.label}-*.png")):
        print(f)


def cmd_quit(a):
    d = env_dir(a.name)
    rig = load(d, fixed=False)
    stop_live(d, rig)
    print(f"quit: {a.name}'s live app")


def cmd_fleet(a):
    """N isolated envs at once, each up with its own live app: <prefix>1 … <prefix>N."""
    if a.n < 1 or a.n > 8:
        die("fleet: 1 to 8 envs")
    names = [f"{a.prefix}{i}" for i in range(1, a.n + 1)]
    me = [sys.executable, str(Path(__file__).resolve())]
    for n in names:  # up one by one (each picks its own free port), then all live at once
        p = subprocess.run([*me, "up", n], capture_output=True, text=True)
        if p.returncode != 0:
            die(f"up {n}: {p.stderr.strip()}")
    live = [[*me, "live", n, "--size", a.size] + (["--abe"] if a.abe else []) for n in names]
    procs = [subprocess.Popen(c, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) for c in live]
    bad = []
    for n, p in zip(names, procs):
        out, _ = p.communicate()
        print(out.strip())
        if p.returncode != 0:
            bad.append(n)
    if bad:
        die(f"fleet: {', '.join(bad)} did not come up")
    print(f"# fleet: {' '.join(names)} (qarig do <name> …; qarig down <name> each)", file=sys.stderr)


def ado_call(d, rig, method, path, body, who):
    import urllib.error
    import urllib.request

    seed = json.loads(Path(rig["seed"]).read_text())
    base = rig.get("ado_url") or f"http://127.0.0.1:{rig['ado_port']}"
    url = f"{base}/qa-rig/{urllib.request.quote(seed.get('project', 'Sandbox'))}/_apis/wit/{path}"
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        method=method,
        headers={"Authorization": "Bearer fake-token", "Content-Type": "application/json-patch+json", "X-Fake-As": who},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read() or b"{}")


def cmd_teammate(a):
    d = env_dir(a.name)
    rig = load(d)
    t0 = time.time()
    what = " ".join([a.service, a.action, *a.args])
    if a.service == "azure":
        if a.action == "move" and len(a.args) == 2:
            card, state = a.args
            status, js = ado_call(d, rig, "PATCH", f"workitems/{card}?api-version=7.1", [{"op": "add", "path": "/fields/System.State", "value": state}], a.who)
        elif a.action == "comment" and len(a.args) == 2:
            card, text = a.args
            status, js = ado_call(d, rig, "POST", f"workItems/{card}/comments?api-version=7.1-preview.4", {"text": text}, a.who)
        else:
            die("teammate azure move <card> <state> | comment <card> '<text>' [--as sam]")
        ok = status == 200
        qarig_drive.log(d, "teammate", f"{what} --as {a.who}", {"ok": ok, "error": js.get("message")}, int((time.time() - t0) * 1000))
        if not ok:
            die(f"the board refused ({status}): {js.get('message')}")
        print(f"ok: {what} as {a.who}")
        return
    if a.service == "github" and a.action == "push" and len(a.args) == 1:
        branch = a.args[0]
        if branch.startswith("-") or subprocess.run(["git", "check-ref-format", "--branch", branch], capture_output=True).returncode != 0:
            die(f"not a branch name: {branch!r}")
        work = d / "teammate" / branch.replace("/", "_")
        shutil.rmtree(work, ignore_errors=True)
        origin = f"https://github.com/{rig['gh_repo']}.git" if rig.get("real") else d / "origin.git"
        if not rig.get("real") and not origin.exists():
            die(f"env {a.name} has no local origin (a --path repo): push there yourself")
        name = a.who.capitalize()
        genv = abe_env(d, rig) if rig.get("real") else None  # the env's git credential: your gh
        g = lambda *c: subprocess.run(["git", *c], cwd=work, check=True, capture_output=True, text=True, env=genv)
        subprocess.run(["git", "clone", "-q", str(origin), str(work)], check=True, capture_output=True, env=genv)
        has = subprocess.run(["git", "-C", str(work), "ls-remote", "--heads", "origin", branch], capture_output=True, text=True, env=genv).stdout.strip()
        g("checkout", "-q", "-B", branch, f"origin/{branch}" if has else "origin/main")
        f = work / "TEAMMATE.md"
        f.write_text((f.read_text() if f.exists() else "") + f"- {name} at {time.strftime('%H:%M:%S')}\n")
        g("add", "TEAMMATE.md")
        g("-c", f"user.name={name}", "-c", f"user.email={a.who}@example.test", "commit", "-qm", f"{name}'s change")
        g("push", "-q", "origin", f"HEAD:{branch}")
        qarig_drive.log(d, "teammate", f"{what} --as {a.who}", {"ok": True}, int((time.time() - t0) * 1000))
        print(f"ok: {a.who} pushed {branch}")
        return
    if a.service == "github" and a.action == "comment" and len(a.args) == 2:
        if not rig.get("real"):
            die("teammate github comment needs a real env (qarig up --real): the fake gh has no pull requests")
        pr, text = a.args
        if not pr.isdigit():
            die(f"a pull request number, not {pr!r}")
        if a.who != "sam":
            print(f"# --as {a.who}: GitHub writes go as gh's one login", file=sys.stderr)
        # as you (the env's one GitHub login): the comment comes from outside the app all the same
        p = real_gh("pr", "comment", pr, "-R", rig["gh_repo"], "--body", text, check=False)
        qarig_drive.log(d, "teammate", f"{what} (as gh's login)", {"ok": p.returncode == 0, "error": p.stderr.strip()[-200:]}, int((time.time() - t0) * 1000))
        if p.returncode != 0:
            die(f"gh pr comment: {p.stderr.strip()[-300:]}")
        print(f"ok: commented on {rig['gh_repo']}#{pr}")
        return
    die("teammate azure move|comment … | github push <branch> | github comment <pr> '<text>' (real envs)")


# ---------------------------------------------------------------- gate runs (#352)

GATE_OUT = Path(os.environ.get("QARIG_GATE_OUT", RIG / "gate"))
ME = [sys.executable, str(Path(__file__).resolve())]


def built_commit():
    """The commit the driven build is from: QARIG_COMMIT, else the shared build's BUILT."""
    if os.environ.get("QARIG_COMMIT"):
        return os.environ["QARIG_COMMIT"]
    if "QARIG_BIN" not in os.environ and (RIG / "BUILT").exists():
        return (RIG / "BUILT").read_text().split()[0]
    return "local"


def gate_script(path):
    """The script as given, else under the shared build's checkout (the release commit's own)."""
    f = Path(path)
    if f.exists():
        return f.resolve()
    if not f.is_absolute() and (BUILD / f).exists():
        return BUILD / f
    die(f"no gate script {path} (here or in {BUILD})")


class QarigCtx(qarig_gate.Ctx):
    """A gate run's world: qarig's own verbs on the env (so drive.log has every one) and the
    listed reads in the env's env."""

    def __init__(self, name, d, rig, serves_before):
        self.name, self.d, self.rig, self.before = name, d, rig, serves_before

    def qarig(self, *args, timeout=None):
        t0 = time.time()
        try:
            p = subprocess.run([*ME, *map(str, args)], capture_output=True, text=True, timeout=timeout)
            code, said = p.returncode, p.stdout + p.stderr
        except subprocess.TimeoutExpired:
            code, said = 124, f"qarig {args[0]}: no end in {timeout}s"
        m = re.search(r"^ok (\d+) ms", said, re.M)
        return code, int(m.group(1)) if m else int((time.time() - t0) * 1000), said

    def drive(self, verb, args, out):
        n = self.name
        if verb == "do":
            code, ms, said = self.qarig("do", n, args[0])
        elif verb == "type":
            code, ms, said = self.qarig("do", n, "--type", args[0])
        elif verb == "click":
            code, ms, said = self.qarig("do", n, "--click", args[0])
        elif verb == "wait":
            w = args[0]
            extra = (["--in", w["in"]] if w["in"] else []) + (["--gone"] if w["gone"] else [])
            code, ms, said = self.qarig("wait", n, w["text"], "--timeout", w["within"], *extra)
            if code != 0:
                said += self.timed_out(said, out)
        elif verb == "see":
            label, parts = args[0], args[1:]
            code, ms, said = self.qarig("see", n, *parts)
            if label and out is not None:
                f = out / "trees" / f"{label}.txt"
                f.parent.mkdir(parents=True, exist_ok=True)
                f.write_text(said)
                said += f"\nevidence trees/{label}.txt"
        elif verb == "snap":
            code, ms, said = self.qarig("snap", n, args[0])
            if code == 0:
                said += "\nevidence " + self.keep(Path(said.strip().splitlines()[-1]), out / "shots" / f"{args[0]}.png", out)
        elif verb == "film":
            label, frames, every, keys = args
            code, ms, said = self.qarig("film", n, label, keys, "--frames", frames, "--every", every)
            if code == 0:
                said += "\nevidence " + self.keep(self.d / "shots" / label, out / "films" / label, out) + f"/{label}.html"
        elif verb == "timeout":  # a regex wait gave up: its evidence, as a wait's
            text, seen = args
            slug = "".join(c if c.isalnum() else "-" for c in text)[:30]
            src = self.d / "logs/timeouts" / f"{time.strftime('%H%M%S')}-{slug}"
            src.mkdir(parents=True, exist_ok=True)
            (src / "trees.txt").write_text(seen)
            self.qarig("snap", n, f"timeout-{src.name}"[:60])
            snap = self.d / "shots" / f"timeout-{src.name}"[:60]
            self.keep(snap, src / "snap", src)
            serve = self.d / "logs/serve.log"
            if serve.exists():
                (src / "serve-tail.log").write_text("\n".join(serve.read_text(errors="replace").splitlines()[-200:]) + "\n")
            code, ms, said = 0, 0, self.timed_out(f"evidence {src}", out)
        elif verb == "teammate":
            code, ms, said = self.qarig("teammate", n, *args)
        elif verb == "scenario":
            code, ms, said = self.qarig("scenario", n, *args, timeout=300)
        elif verb == "down":
            code, ms, said = self.qarig("down", n, timeout=300)
            if code == 0:
                end = time.time() + 15  # a serve still stopping is given its stop time
                left = self.left_running()
                while left and time.time() < end:
                    time.sleep(0.5)
                    left = self.left_running()
                if left:
                    code, said = 1, said + "\nstill running: " + "; ".join(left)
        else:
            raise qarig_gate.GateError(f"qarig has no {verb}")
        return code == 0, ms, said

    def keep(self, src, dst, out):
        if not src.exists():
            return ""
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.is_dir():
            shutil.rmtree(dst, ignore_errors=True)
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)
        return str(dst.relative_to(out))

    def timed_out(self, said, out):
        """A wait that timed out: its evidence (trees, PNG, serve log) and 5 s of film after it."""
        m = re.search(r"evidence (/\S+)", said)
        if not m:
            return ""
        src = Path(m.group(1))
        kept = self.keep(src, out / "timeouts" / src.name, out)
        dst = out / "timeouts" / src.name
        drive_log = self.d / "logs/drive.log"
        if drive_log.exists():
            (dst / "drive-tail.log").write_text("\n".join(drive_log.read_text(errors="replace").splitlines()[-50:]) + "\n")
        code, said_sessions = self.shell(["abe", "session", "list", "--json"])
        (dst / "sessions.json").write_text(said_sessions)
        label = f"timeout-{src.name}"[:60]
        code, _, _ = self.qarig("film", self.name, label, "", "--frames", 20, "--every", 250, timeout=180)
        if code == 0:
            self.keep(self.d / "shots" / label, out / "timeouts" / src.name / "film", out)
        return f"\nevidence {kept}"

    def left_running(self):
        """What still runs after down: a process naming the env's folder, or a new serve under
        the real HOME (the #213 orphans)."""
        ps = subprocess.run(["ps", "-axww", "-o", "pid=,command="], capture_output=True, text=True).stdout
        mine = {os.getpid(), os.getppid()}
        left = []
        for line in ps.splitlines():
            pid, _, cmd = line.strip().partition(" ")
            if pid.isdigit() and int(pid) not in mine and str(self.d) in cmd and "qarig" not in cmd.split(" ", 1)[0]:
                left.append(f"pid {pid} {cmd[:120]}")
        for pid, x in sorted(serves().items()):
            if pid not in self.before and x.get("HOME") == REAL_HOME:
                left.append(f"STRAY SERVE pid {pid} under the real HOME")
        return left

    def shell(self, argv):
        argv = list(argv)
        if argv[0] == "abe":
            argv[0] = self.rig["abe_bin"]
        try:
            p = subprocess.run(argv, env=abe_env(self.d, self.rig), cwd=self.rig["path"], capture_output=True, text=True, timeout=120)
            return p.returncode, p.stdout + p.stderr
        except subprocess.TimeoutExpired:
            return 124, f"{argv[0]}: no end in 120s"
        except FileNotFoundError:
            return 127, f"no {argv[0]}"


def gate_out(a, name):
    return Path(a.out).resolve() if getattr(a, "out", None) else GATE_OUT / built_commit() / name


def cmd_gate(a):
    script = gate_script(a.script)
    try:
        steps = qarig_gate.parse(script.read_text(), script.name)
    except qarig_gate.GateError as e:
        die(str(e))
    only = [x for x in (a.only or "").split(",") if x]
    d = env_dir(a.name)
    if a.dry_run:
        for st in steps:
            if (only and st.id not in only):
                continue
            print(f"{st.id} · {st.title}")
            for x in st.actions:
                print(f"  {x.text}")
        return
    rig = load(d)
    out = gate_out(a, a.name)
    meta = qarig_gate.load_meta(out)
    if meta.get("script") and meta["script"] != script.name:
        die(f"{out} holds a run of {meta['script']}: --out another folder")
    if not (a.start or only):
        if (out / "meta.json").exists() and (out / "results.json").exists():
            shutil.rmtree(out)  # a run from the top starts clean (only a gate run's folder)
        meta = {}
    meta = {
        "script": script.name,
        "name": a.name,
        "commit": built_commit(),
        "started": meta.get("started") or time.strftime("%Y-%m-%d %H:%M:%S"),
        "serves_before": meta.get("serves_before") or sorted(serves()),
    }
    ctx = QarigCtx(a.name, d, rig, set(meta["serves_before"]))
    vars_ = {"name": a.name, "repo": rig["path"], "seed_offset": rig.get("seed_offset", 0)}
    try:
        rows, status = qarig_gate.run(steps, ctx, out, vars_, meta, start=a.start, only=only, keep_going=a.keep_going)
    except qarig_gate.GateError as e:
        die(str(e))
    print((out / "RESULT.md").read_text(), end="", flush=True)
    print(f"# {out / 'RESULT.md'}", file=sys.stderr)
    if status == "fail":
        sys.exit(1)
    if status.startswith("agent:"):
        _, at, *after = status.split(":")
        what = next((r.check for r in reversed(rows) if r.result == "AGENT"), "")
        go_on = f"qarig gate {a.name} {a.script} --from {after[0]}" if after else "the script's last step"
        print(f"# the tester agent's turn ({at}): {what}\n# then: {go_on}", file=sys.stderr)
        sys.exit(4)


def cmd_judge(a):
    out = gate_out(a, a.name)
    try:
        r = qarig_gate.judge(out, a.row, a.verdict, a.note)
    except qarig_gate.GateError as e:
        die(str(e))
    print(f"{r.id} {r.result}: {r.check} — {r.note}")


def main():
    p = argparse.ArgumentParser(prog="qarig", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("shot")
    s.add_argument("name")
    s.add_argument("label")
    s.add_argument("keys", nargs="?", default="")
    s.add_argument("--frames", type=int, default=0)
    s.add_argument("--every", type=int, default=100)
    s.add_argument("--size", default="1400x900")
    s.add_argument("--path")
    s.add_argument("--delay", type=int, default=2500, help="ms before the keys and after them (default 2500)")
    s.add_argument("--abe", action="store_true", help="show the Factory view first ({@super+alt+a})")
    s.add_argument("--abe-wait", type=int, default=2500)
    s.add_argument("--timeout", type=int, default=240)
    s.set_defaults(fn=cmd_shot)

    u = sub.add_parser("up")
    u.add_argument("name")
    u.add_argument("--seed", help="a fake Azure DevOps seed JSON (default the testing package's)")
    u.add_argument("--path", help="the project folder (default a demo repo with a bare origin); sessions make <path>-wt/ beside it and fetch its origin: use a throwaway copy")
    u.add_argument("--box", help="not yet: boxes need AWS; see the README")
    u.add_argument("--real", action="store_true", help="a release gate env: a private copy of the gate repo (qarig.local.toml), your gh / aws / claude logins in place, real boxes (deleted by down)")
    u.add_argument("--seed-offset", type=int, default=0, help="add this to every seed card's number (gate testers: 100, 200); {card:N} in gate scripts")
    u.set_defaults(fn=cmd_up)
    for name, fn in (("down", cmd_down), ("env", cmd_env)):
        x = sub.add_parser(name)
        x.add_argument("name")
        x.set_defaults(fn=fn)
    x = sub.add_parser("abe", help="run abe in an env: qarig abe <name> card list")
    x.add_argument("name")
    x.add_argument("args", nargs=argparse.REMAINDER)
    x.set_defaults(fn=cmd_abe)
    sub.add_parser("ls").set_defaults(fn=cmd_ls)
    x = sub.add_parser("scenario", help="qarig scenario <name> list")
    x.add_argument("name")
    x.add_argument("scenario")
    x.add_argument("--card", type=int, default=4)
    x.add_argument("--after", type=int, default=None)
    x.add_argument("--every", type=int, default=4000)
    x.add_argument("--option", type=int, default=1)
    x.add_argument("--factory", action="store_true")
    x.add_argument("--text")
    x.add_argument("--box")
    x.add_argument("--state", choices=["pending", "running", "stopping", "stopped", "shutting-down", "terminated"])
    x.add_argument("--held", action="store_true")
    x.add_argument("--repo", help="box: the repo it is tagged with (owner/name; default qa-rig/demo-shop)")
    x.add_argument("--runs", type=int, default=40, help="pipelines: how many runs (0: none again)")
    x.set_defaults(fn=cmd_scenario)
    x = sub.add_parser("diff", help="frame-diff a film: qarig diff <name> <label> | <folder>")
    qarig_diff.add_args(x)
    x.set_defaults(fn=cmd_diff)
    r = sub.add_parser("rebuild")
    r.add_argument("--ref", help="what to build (default this checkout's HEAD)")
    r.set_defaults(fn=cmd_rebuild)

    x = sub.add_parser("live", help="start the env's live, driven app")
    x.add_argument("name")
    x.add_argument("--size", default="1400x900")
    x.add_argument("--path")
    x.add_argument("--abe", action="store_true", help="show the Factory view first")
    x.add_argument("--fps", type=int, default=10, help="draws a second of the hidden window (10)")
    x.add_argument("--keep", action="store_true", help="keep <env>/state/live (a restart: the open set, pages, sessions)")
    x.add_argument("--no-path", action="store_true", help="launch without a path, as the Dock does (with --keep: reopens the last open set)")
    x.set_defaults(fn=cmd_live)
    x = sub.add_parser("do", help="play keys / text / a click in the live app")
    x.add_argument("name")
    x.add_argument("keys", nargs="?", default="")
    x.add_argument("--type")
    x.add_argument("--key-ms", type=int, default=150, help="--type: ms between its keys (150; the hidden window draws every 100)")
    x.add_argument("--click")
    x.add_argument("--timeout", type=int, default=600, help="seconds the keys may take (600)")
    x.set_defaults(fn=cmd_do)
    x = sub.add_parser("see", help="what the live app shows, as text")
    x.add_argument("name")
    x.add_argument("parts", nargs="*")
    x.add_argument("--json", action="store_true")
    x.set_defaults(fn=cmd_see)
    x = sub.add_parser("wait", help="wait for a text in the live app")
    x.add_argument("name")
    x.add_argument("text")
    x.add_argument("--in", dest="within", choices=list(qarig_drive.PARTS))
    x.add_argument("--gone", action="store_true")
    x.add_argument("--timeout", default="60s", help="90s, 10m (60s)")
    x.set_defaults(fn=cmd_wait)
    x = sub.add_parser("snap", help="a PNG of the live window")
    x.add_argument("name")
    x.add_argument("label")
    x.set_defaults(fn=cmd_snap)
    x = sub.add_parser("film", help="frames of the live window while keys play")
    x.add_argument("name")
    x.add_argument("label")
    x.add_argument("keys", nargs="?", default="")
    x.add_argument("--frames", type=int, default=30)
    x.add_argument("--every", type=int, default=100)
    x.add_argument("--timeout", type=int, default=600)
    x.set_defaults(fn=cmd_film)
    x = sub.add_parser("quit", help="quit the env's live app")
    x.add_argument("name")
    x.set_defaults(fn=cmd_quit)
    x = sub.add_parser("fleet", help="N isolated envs, each up with a live app")
    x.add_argument("n", type=int)
    x.add_argument("--prefix", default="t")
    x.add_argument("--abe", action="store_true")
    x.add_argument("--size", default="1400x900")
    x.set_defaults(fn=cmd_fleet)
    x = sub.add_parser("teammate", help="a teammate's change from outside the app")
    x.add_argument("name")
    x.add_argument("service", choices=["azure", "github"])
    x.add_argument("action")
    x.add_argument("args", nargs="*")
    x.add_argument("--as", dest="who", default="sam")
    x.set_defaults(fn=cmd_teammate)

    x = sub.add_parser("gate", help="run a gate script on the env's live app")
    x.add_argument("name")
    x.add_argument("script")
    x.add_argument("--from", dest="start", help="start at this step (a run picked up after the agent's turn)")
    x.add_argument("--only", help="only these steps: G1,G4")
    x.add_argument("--keep-going", action="store_true", help="a FAIL ends its step, not the run (a later down is skipped)")
    x.add_argument("--dry-run", action="store_true", help="parse and list the steps, run nothing")
    x.add_argument("--out", help="the results folder (default .scratch/qa/gate/<commit>/<name>)")
    x.set_defaults(fn=cmd_gate)
    x = sub.add_parser("judge", help="the tester agent's verdict on a judge row")
    x.add_argument("name")
    x.add_argument("row")
    x.add_argument("verdict", choices=["PASS", "FAIL"])
    x.add_argument("note")
    x.add_argument("--out")
    x.set_defaults(fn=cmd_judge)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
