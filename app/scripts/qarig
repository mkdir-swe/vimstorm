        ],
    )
    p = launch(d, rig, o.card, True)
    print(p.stdout.strip() or p.stderr.strip())


@scenario("working", "a plain session on --card that keeps working (tool calls every 2 s for --after ms, 60000)")
def sc_working(d, rig, o):
    stop_card(d, rig, o.card)
    steps = []
    for i in range(max(1, o.after // 2000)):
        steps += [
            {"hook": "PreToolUse", "payload": {"tool_name": "Read", "tool_input": {"file_path": f"src/cart.ts"}}},
            {"sleep": 1000},
            {"hook": "PostToolUse", "payload": {"tool_name": "Read", "tool_input": {"file_path": "src/cart.ts"}, "tool_response": {"type": "text"}}},
            {"sleep": 1000},
        ]
    steps.append({"say": "Done reading."})
    script_claude(d, steps)
    p = launch(d, rig, o.card, False)
    print(p.stdout.strip() or p.stderr.strip())


