#!/usr/bin/env python3
"""qarig: the parallel QA rig. Many testers drive and film VimStorm + Abe at once, offscreen (the
`shots` build: no window shown, no focus taken, no OS keystrokes), each on an isolated env.

  qarig up <name> [--seed <json>] [--seed-offset n] [--path <folder>]
                                                    an env under /tmp/qr/<name>: fake Azure DevOps on
                                                    a free port, fake az / gh / claude, a Layer, abe serve;
                                                    the demo repo's origin is github.com/qa-rig/demo-shop
  qarig up <name> --real [--seed-offset n]          a release gate env: a private copy of the gate repo
                                                    (<org>/gate-<name>-<4hex>), your gh / aws / claude logins where
                                                    they live, an Override limits.maxBoxesPerPerson 6,
                                                    the fake board on the repo's seed,
                                                    stores.org its own prefix gate/<name>-<4hex>/ of the org store;
                                                    boxes come from the app's Launch, down deletes them, the copy
                                                    and the prefix; the org, repos and AWS profile come from
                                                    qarig.local.toml beside this file (untracked; copy
                                                    qarig.local.example.toml)
  qarig shot <name> <label> '<keys>' [--frames n --every ms] [--size WxH] [--path <folder>]
             [--delay ms] [--abe]                   one offscreen run of the shared binary; prints PNG paths
                                                    (starts the env's serve first if it is not answering; exit 3 when
                                                    a new serve under the real HOME, or the shot's under any other, appeared)
  qarig scenario <name> <scenario> [args]           drive serve state (qarig scenario <name> list)
  qarig env <name>                                  the env to source (also /tmp/qr/<name>/env.sh)
  qarig down <name>                                 stop everything of <name> (--real: its boxes, repo copy and store prefix deleted)
  qarig ls                                          the envs and what runs
  qarig diff <name> <label> | <folder>              read a film cheaply: <label>-diff.tsv, <label>-sheet.png and the flagged frames
  qarig rebuild [--ref <commit>]                    rebuild the shared shots binary + abe from this checkout's HEAD
                                                    (or --ref) in .scratch/qa/build (locked; QARIG_HOME moves .scratch/qa)

A live, driven app (the drive socket, #232: one app start, driven step by step, never shown):
  qarig live <name> [--size WxH] [--abe] [--path <folder>] [--fps n] [--keep] [--no-path]
                                                  start it (pid + socket in rig.json); --keep keeps the last
                                                  run's state, --no-path launches as the Dock does (restart tests)
  qarig do <name> '<keys>' | --type '<text>' | --click x,y            play keys / text / a click
  qarig see <name> [part…] [--json]               the trees (main chat pane review layer), status, balloons, title, view, terminal
  qarig wait <name> '<text>' [--in part] [--gone] [--timeout 10m]      exit 1 on timeout (evidence in logs/timeouts/)
  qarig snap <name> <label>                       PNG of the live window: shots/<label>/<label>.png
  qarig film <name> <label> '<keys>' --frames n --every ms             frames while the keys play, + flipbook
  qarig teammate <name> azure move <card> <state> --as sam | azure comment <card> '<text>' --as sam
                 | github push <branch> [--as sam]                     a teammate's change from outside the app
  qarig quit <name>                               quit the live app (down does too)
  qarig fleet <n> [--prefix t] [--abe] [--size WxH]                    N isolated envs, each up with a live app
Every do / wait / teammate goes to <env>/logs/drive.log with its ms.

A gate run (#352: a script of steps, each do → check → evidence; app/scripts/qarig_gate.py):
  qarig gate <name> <script.md> [--from G2] [--only G1,G4] [--keep-going] [--dry-run] [--out dir]
             runs it on the env's live app; RESULT.md + trees/ shots/ films/ runs/ in
             .scratch/qa/gate/<commit>/<name>/ (exit 0 pass, 1 fail, 4 the tester agent's turn)
  qarig judge <name> <row> PASS|FAIL '<what was seen>'   the tester agent's verdict on a judge row

Keys (VIMSTORM_SHOT_KEYS, see app/src/devtools/shot.rs): plain text = nvim input; {@tab} {@k} {@super+alt+a}
GPUI keys (the Factory view takes only these); {type:text}; {wait:ms}; {shot:label}; {@click x,y};
{@move x,y}; {@scroll dy}; {lua:code:lua}. Coordinates are logical px from the window's top left.
"""

import argparse
import json
import fcntl
import hashlib
import os
import pwd
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import qarig_diff  # noqa: E402  (the film frame-diff, beside this file)
import qarig_drive  # noqa: E402  (the drive socket's client)
import qarig_gate  # noqa: E402  (the gate runner: tests/gate/*.md)

HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent  # the checkout this qarig is in (rebuild builds its HEAD, or --ref)
RIG = Path(os.environ.get("QARIG_HOME", REPO / ".scratch/qa"))  # the shared build's lock, BUILT, READY, gate runs
BUILD = Path(os.environ.get("QARIG_BUILD", RIG / "build"))  # the checkout the shared build is from (a detached worktree of REPO)
TARGET = Path(os.environ.get("QARIG_TARGET", RIG / "target"))
BIN = Path(os.environ.get("QARIG_BIN", TARGET / "release/vimstorm"))  # QARIG_BIN: another shots build
ABE_BIN = Path(os.environ.get("QARIG_ABE_BIN", TARGET / "abe/abe-darwin-arm64"))  # copied there by rebuild: the checkout's dist/ may move on
ROOT = Path(os.environ.get("QARIG_ROOT", "/tmp/qr"))  # envs: short, a socket path is at most 104 bytes


def die(msg, code=1):
    print(f"qarig: {msg}", file=sys.stderr)
    sys.exit(code)


def env_dir(name):
    if not name or "/" in name or name.startswith("."):
        die(f"bad name {name!r}")
    return ROOT / name


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def write(path, text, mode=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    if mode:
        path.chmod(mode)


# Envs before 2 put volta's node shim on serve's PATH under the env's HOME: a fork bomb.
RIG_VERSION = 2


def load(d, fixed=True):
    """The env's rig.json; with `fixed`, refused for an env made before the PATH fix."""
    f = d / "rig.json"
    if not f.exists():
        die(f"no env {d.name}: qarig up {d.name}")
    rig = json.loads(f.read_text())
    pinned = sorted(k for k in rig.get("extra_env", {}) if is_pinned(k))
    if fixed and pinned:
        die(
            f"env {d.name}'s rig.json extra_env sets {', '.join(pinned)}: an env's HOME, state, socket, "
            f"config and abe are always its own (a serve started under another HOME reads and writes "
            f"that HOME's Abe state). Take them out of {f}, or re-make it: qarig down {d.name} && qarig up {d.name}"
        )
    if fixed and rig.get("version", 1) < RIG_VERSION:
        die(
            f"env {d.name} was made before the 03:05 PATH fix (its serve can fork-bomb on node): "
            f"re-make it: qarig down {d.name} && qarig up {d.name}"
        )
    if rig.get("path") and Path(rig["path"]).exists():
        rig["path"] = real(rig["path"])  # envs made before the fix name /tmp/…, serve /private/tmp/…
    return rig


def save(d, rig):
    write(d / "rig.json", json.dumps(rig, indent=2) + "\n")


def alive(pgid):
    if not pgid or pgid <= 1:
        return False
    try:
        os.killpg(pgid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def ours(pgid):
    """The group still is one qarig started (a reused pid is left alone)."""
    out = subprocess.run(["ps", "-o", "command=", "-p", str(pgid)], capture_output=True, text=True).stdout
    return out.startswith("/bin/sh -c exec sleep 2147483647 | exec ")


def group_runs_more_than_its_sleep(pgid):
    """A daemon's group still runs its program (not only the `sleep` holding its stdin open)."""
    out = subprocess.run(["ps", "-axo", "pgid=,command="], capture_output=True, text=True).stdout
    for line in out.splitlines():
        g, _, cmd = line.strip().partition(" ")
        if g == str(pgid) and not cmd.startswith(("sleep ", "/bin/sh -c exec sleep ")):
            return True
    return False


def daemon(argv, log, env, cwd=None):
    """Starts argv in a session of its own (stdin a pipe that stays open: the fake ADO ends when
    its stdin closes), its output to log; returns its process group id."""
    log.parent.mkdir(parents=True, exist_ok=True)
    cmd = "exec sleep 2147483647 | exec " + " ".join(sh_quote(a) for a in argv)
    p = subprocess.Popen(
        ["/bin/sh", "-c", cmd],
        stdout=open(log, "ab"),
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        env=env,
        cwd=cwd,
        start_new_session=True,
    )
    return p.pid


def sh_quote(s):
    s = str(s)
    if s and all(c.isalnum() or c in "@%+=:,./-_" for c in s):
        return s
    return "'" + s.replace("'", "'\"'\"'") + "'"


def wait_for(check, secs, what):
    end = time.time() + secs
    while time.time() < end:
        if check():
            return
        time.sleep(0.2)
    die(f"timed out waiting for {what}")


# What makes an env an env: whatever abe or the app starts (a serve the bridge starts when none
# answers too) inherits these, so they are set last and never taken from extra_env.
PINNED = ("HOME", "ABE_BIN", "ABE_STATE_DIR", "ABE_SOCKET", "ABE_CONFIG_DIR", "QARIG_NAME", "VIMSTORM_NO_INSTANCE")


def is_pinned(k):
    return k in PINNED or k.startswith("XDG_")


def pinned_env(d, rig):
    return {
        "ABE_BIN": str(rig["abe_bin"]),
        "ABE_STATE_DIR": str(d / "s"),
        "ABE_SOCKET": str(d / "s/s.sock"),
        "ABE_CONFIG_DIR": str(d / "cfg"),
        "HOME": str(d / "home"),
        "VIMSTORM_NO_INSTANCE": "1",
        "QARIG_NAME": d.name,
    }


def serve_home(d, rig):
    """The HOME the env's serve runs under: the env's own; a --real env's the real one, where its
    claude (yours, bin/claude) writes the transcripts serve reads (~/.claude/projects)."""
    return REAL_HOME if rig.get("real") else str(d / "home")


def serve_env(d, rig):
    """The env's serve's env: abe_env, but under serve_home. Its state, config and socket stay the
    env's (pinned), git's global config the env's (its identity and gh credential helper)."""
    env = abe_env(d, rig)
    if rig.get("real"):
        env.update(HOME=REAL_HOME, GIT_CONFIG_GLOBAL=str(d / "home/.gitconfig"))
    return env


def abe_env(d, rig):
    """The env every abe process of this rig gets (serve, the bridge, scenario commands)."""
    env = dict(os.environ)
    drop = ("ABE_", "AWS_", "CLAUDE", "ANTHROPIC_", "OPENAI_", "AZURE_", "GITHUB_", "GH_", "COPILOT_", "XDG_", "NVIM", "VIMSTORM_", "DATABASE_", "QARIG_", "VOLTA_", "SSH_AUTH")
    for k in list(env):
        if k.startswith(drop):
            del env[k]
    env.update(
        {
            "ABE_ADO_BASE_URL": f"http://127.0.0.1:{rig['ado_port']}",
            "PATH": f"{d / 'bin'}:{env.get('PATH', '/usr/bin:/bin')}",
            # serve keeps this PATH (on darwin it would take the login shell's: the real
            # claude / gh / az before the fakes)
            "ABE_LOGIN_PATH": "off",
            "ABE_OWNER": "qa-rig",
        }
    )
    if rig.get("real"):
        del env["ABE_OWNER"]  # a real env is yours: your boxes are found by your gh login
    # No version-manager shim on the env's PATH: under the env's own HOME volta's node shim
    # re-runs itself forever (a fork bomb, VOLTA_HOME or not). The real node / npm / npx dirs
    # come first instead, resolved once under the real HOME.
    env["PATH"] = ":".join([str(d / "bin"), *real_tool_dirs(), *rig.get("real_dirs", []), *(p for p in env["PATH"].split(":") if not shim_dir(p))])
    env.update({k: v for k, v in rig.get("extra_env", {}).items() if not is_pinned(k)})
    env.update(pinned_env(d, rig))
    return env


SHIM_DIRS = (".volta/bin", ".asdf/shims", ".pyenv/shims", ".rbenv/shims", ".nodenv/shims", ".local/share/mise/shims", "Library/pnpm")


def shim_dir(p):
    home = str(Path(pwd.getpwuid(os.getuid()).pw_dir))
    return any(p.rstrip("/") == f"{home}/{s}" for s in SHIM_DIRS) or p.startswith(str(ROOT))


_TOOL_DIRS = None


def real_tool_dirs():
    """The dirs of the real node, npm and npx (what volta's shims would run), once."""
    global _TOOL_DIRS
    if _TOOL_DIRS is None:
        dirs = []
        real_home = pwd.getpwuid(os.getuid()).pw_dir
        env = dict(os.environ, HOME=real_home)
        for tool in ("node", "npm", "npx"):
            path = None
            if shutil.which("volta"):
                try:
                    out = subprocess.run(["volta", "which", tool], env=env, capture_output=True, text=True, timeout=10)
                    path = out.stdout.strip() if out.returncode == 0 else None
                except subprocess.TimeoutExpired:
                    path = None
            if path and Path(path).is_file() and str(Path(path).parent) not in dirs:
                dirs.append(str(Path(path).parent))
        if not dirs:
            for c in ("/opt/homebrew/bin", "/usr/local/bin"):
                if (Path(c) / "node").is_file():
                    dirs.append(c)
                    break
        _TOOL_DIRS = dirs
    return _TOOL_DIRS


def abe(d, rig, *args, check=True, json_out=False, timeout=60):
    argv = [rig["abe_bin"], *args] + (["--json"] if json_out else [])
    p = subprocess.run(
        argv,
        env=abe_env(d, rig),
        cwd=rig["path"],
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if check and p.returncode != 0:
        die(f"abe {' '.join(args)}: exit {p.returncode}\n{p.stdout}{p.stderr}")
    if json_out:
        try:
            return json.loads(p.stdout)
        except json.JSONDecodeError:
            if not check:
                return {}
            die(f"abe {' '.join(args)}: not JSON\n{p.stdout}{p.stderr}")
    return p


# ---------------------------------------------------------------- up / down

SEED = BUILD / "abe/packages/testing/src/servers/fake-ado/seed.json"
FAKE_CLAUDE = BUILD / "abe/packages/testing/src/tools/fake-claude/claude.ts"
FAKE_EC2 = BUILD / "abe/packages/testing/src/tools/fake-ec2/aws.ts"
# fake-ec2/state.ts's Ec2State; template and sizes are @abe/core's BOX_LAUNCH_TEMPLATE / BOX_SIZES
EC2_STATE = {
    "owner": "qa-rig",
    "sso": "qa-rig",
    "template": "abe-box",
    "templateVersion": 11,
    "lead": False,
    "sizes": ["m8g.large", "m8g.xlarge", "m8g.2xlarge", "m8g.4xlarge", "m8g.8xlarge", "m8g.12xlarge", "m8g.16xlarge"],
    "bootMs": 20000,
    "stopMs": 8000,
    "expired": False,
    "next": 1,
    "instances": [],
}
FAKE_ADO = BUILD / "abe/packages/testing/src/servers/fake-ado/server.ts"

AZ = """#!/bin/sh
# qarig's az: a fixed fake token for the fake Azure DevOps (never a real login), answered in the
# shape real az gives each ask: the account's name for `account show`, only the asked field for
# `--query … -o tsv`, the token JSON for `get-access-token -o json`.
case "$*" in
  "version"*) echo '{"azure-cli":"2.67.0"}';;
  "login"*) echo '[]';;
  "account show"*) echo qa@example.test;;
  "account get-access-token"*"--query expiresOn"*) echo "2099-01-01 00:00:00.000000";;
  "account get-access-token"*) echo '{"accessToken":"fake-token","expiresOn":"2099-01-01 00:00:00.000000","expires_on":4070908800,"tokenType":"Bearer"}';;
  *) echo "qarig: az $1 $2 is not faked" >&2; exit 2;;
esac
"""

DEMO_REPO = "qa-rig/demo-shop"  # the demo repo's GitHub identity (its origin URL; the fake gh answers it)


def install_gh(d):
    """The env's fake gh (qarig_gh.py beside this file): never reaches GitHub, logged out; names the
    cwd's GitHub origin; Actions from <env>/gh/runs.json (`qarig scenario <env> pipelines`)."""
    (d / "bin").mkdir(parents=True, exist_ok=True)
    tmp = d / "bin/gh.new"
    shutil.copyfile(HERE / "qarig_gh.py", tmp)
    tmp.chmod(0o755)
    os.replace(tmp, d / "bin/gh")


def real(path):
    """A path with its symlinks resolved (/tmp is /private/tmp): git and serve name checkouts so."""
    return str(Path(path).resolve())


def make_repo(repo, remote):
    """A small git project with a bare origin, so sessions get a worktree off origin/main. Its origin
    URL is GitHub's (`DEMO_REPO`): the env's ~/.gitconfig sends that URL to the bare origin, and the
    fake gh answers for it, so the shown repo has a GitHub identity."""
    repo.mkdir(parents=True, exist_ok=True)
    files = {
        "README.md": "# Demo shop\n\nThe rig's project.\n",
        "src/cart.ts": "export function total(prices: number[]): number {\n  return prices.reduce((a, b) => a + b, 0);\n}\n",
        "src/signin.ts": "export function signIn(email: string): boolean {\n  return email.includes('@');\n}\n",
        ".gitignore": ".scratch/\nnode_modules/\n.abe/*.local.yaml\n",
    }
    for rel, text in files.items():
        write(repo / rel, text)
    g = lambda *a, cwd=repo: subprocess.run(["git", *a], cwd=cwd, check=True, capture_output=True)
    g("init", "-q", "-b", "main")
    g("-c", "user.name=QA Rig", "-c", "user.email=qa@example.test", "add", "-A")
    g("-c", "user.name=QA Rig", "-c", "user.email=qa@example.test", "commit", "-qm", "Demo shop")
    subprocess.run(["git", "init", "-q", "--bare", "-b", "main", str(remote)], check=True, capture_output=True)
    g("remote", "add", "origin", str(remote))
    g("push", "-q", "origin", "main")  # under the real HOME: the bare path, not the URL
    g("remote", "set-url", "origin", f"https://github.com/{DEMO_REPO}.git")


def origin_rewrite(d):
    """The env's ~/.gitconfig lines sending the demo repo's GitHub URL to its bare origin (git
    reads them under the env's HOME; `git remote get-url` on no global config still says GitHub's)."""
    o = d / "origin.git"
    return f'[url "{o}"]\n\tinsteadOf = https://github.com/{DEMO_REPO}.git\n\tinsteadOf = https://github.com/{DEMO_REPO}\n'


def cmd_up(a):
    d = env_dir(a.name)
    if (d / "rig.json").exists():
        rig = load(d, fixed=False)
        if rig.get("version", 1) < RIG_VERSION and (alive(rig.get("serve_pgid", 0)) or alive(rig.get("ado_pgid", 0))):
            die(f"env {a.name} is from before the 03:05 PATH fix and still runs: qarig down {a.name} first")
        if alive(rig.get("ado_pgid", 0)):
            print_env(d, rig)
            print(f"# {a.name} is up already (qarig down {a.name} first to start over)", file=sys.stderr)
            return
        cmd_down(a, quiet=True)
    if not ABE_BIN.exists():
        die(f"no shared abe at {ABE_BIN}: qarig rebuild")
    if d.exists():  # a fresh env, but a tester's shots and logs stay
        for child in d.iterdir():
            if child.name not in ("shots", "logs"):
                shutil.rmtree(child, ignore_errors=True) if child.is_dir() and not child.is_symlink() else child.unlink()
    for sub in ("s", "cfg", "bin", "home", "logs", "shots", "state"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    if a.real:
        return up_real(a, d)
    seed = Path(a.seed).resolve() if a.seed else SEED
    if not seed.exists():
        die(f"no seed {seed}")
    seed = rig_seed(seed, a.seed_offset, d / "seed.json")
    write(d / "bin/az", AZ, 0o755)
    install_gh(d)
    for tool in ("copilot", "codex", "npx"):
        write(d / f"bin/{tool}", f"#!/bin/sh\necho \"qarig: no real {tool} in a rig env\" >&2\nexit 1\n", 0o755)
    bun = shutil.which("bun") or "/opt/homebrew/bin/bun"
    write(d / "bin/claude", f"#!{bun}\nimport {json.dumps(str(FAKE_CLAUDE))};\n", 0o755)
    # the testing package's fake EC2: the Boxes tab and box states without AWS (state in bin/)
    write(d / "bin/aws", f"#!{bun}\nimport {json.dumps(str(FAKE_EC2))};\n", 0o755)
    write(d / "bin/state.json", json.dumps(EC2_STATE))
    write(
        d / "home/.gitconfig",
        "[user]\n\tname = QA Rig\n\temail = qa@example.test\n[init]\n\tdefaultBranch = main\n" + ("" if a.path else origin_rewrite(d)),
    )
    # yours on this Mac; the board is the repo's .abe/settings.local.yaml (installed())
    write(d / "cfg/settings.yaml", "serve.target: local\n")
    if a.path:
        path = Path(a.path).resolve()
    else:
        make_repo(d / "repo", d / "origin.git")
        path = Path(real(d / "repo"))  # /private/tmp/…: what serve's checkouts say
    installed(d, path, seed)
    rig = {
        "version": RIG_VERSION,
        "name": a.name,
        "abe_bin": str(ABE_BIN),
        "ado_port": free_port(),
        "path": str(path),
        "seed": str(seed),
        "seed_offset": a.seed_offset,
        "extra_env": {"QARIG_DIR": str(d)},
    }
    start_env(d, rig)


# core's INSTALL_PARTS (abe/packages/core/src/install/install.ts), Done last
INSTALL_PARTS = ("logins", "board", "sources", "env-files", "worktree", "checks", "workflows", "skills", "verify", "done")


def installed(d, path, seed):
    """The project as `abe install` leaves it, so cards start there (3.3): a finished install record
    in serve's state (`s/installs/<sha256 of the checkout>[:16]/install.json`, by the path serve or
    the app may name: /private/tmp/… and /tmp/…) and the board in its `.abe/settings.local.yaml`
    (one there already stays)."""
    at = "2026-01-01T00:00:00.000Z"
    names = {str(path)}
    if str(path).startswith("/private/tmp/"):
        names.add(str(path)[len("/private"):])
    # Done is every part passing (core's installDone over INSTALL_PARTS), not finishedAt: parts {}
    # read as todo (status 0 of 9, the Board's "Install in progress")
    check = {"state": "pass", "line": "Set up by the QA rig.", "checkedAt": at}
    parts = {part: dict(check) for part in INSTALL_PARTS}
    for repo in names:
        record = {
            "v": 2, "repo": repo, "startedAt": at, "join": False, "parts": parts, "finishedAt": at,
            "read": None, "board": None, "logins": None, "gate": None, "testHosts": [],
        }
        key = hashlib.sha256(repo.encode()).hexdigest()[:16]
        write(d / "s/installs" / key / "install.json", json.dumps(record, indent=2) + "\n")
    local = path / ".abe/settings.local.yaml"
    if not local.exists():
        s = json.loads(Path(seed).read_text())
        write(
            local,
            f"board:\n  organization: https://dev.azure.com/{RIG_ORG}\n"
            f"  project: {s.get('project', 'Sandbox')}\n  team: {s.get('team', {}).get('name', 'Sandbox')}\n",
        )


def start_env(d, rig):
    """The env's fake board and its serve, then env.sh."""
    port = rig["ado_port"]
    path = rig["path"]
    seed = rig["seed"]
    env = abe_env(d, rig)
    (d / "logs").mkdir(parents=True, exist_ok=True)
    (d / "logs/ado.log").write_text("")
    (d / "logs/serve.log").write_text("")
    rig["ado_pgid"] = daemon(
        ["bun", FAKE_ADO, "--port", port, "--seed", seed, "--log", d / "logs/ado-requests.log"],
        d / "logs/ado.log",
        env,
    )
    save(d, rig)  # down finds it even if a wait below gives up
    wait_for(lambda: "listening" in (d / "logs/ado.log").read_text() or "fake Azure DevOps on" in (d / "logs/ado.log").read_text(), 15, "the fake Azure DevOps")
    rig["serve_pgid"] = daemon([rig["abe_bin"], "serve"], d / "logs/serve.log", serve_env(d, rig), cwd=str(path))
    save(d, rig)
    wait_for(lambda: (d / "s/s.sock").exists(), 20, "abe serve")
    write(d / "env.sh", env_text(d, rig))
    print_env(d, rig)
    print(f"# up: board http://127.0.0.1:{port}, project {path}; source {d / 'env.sh'}", file=sys.stderr)


RIG_ORG = "qa-rig"  # the rig board's Azure DevOps organization
SEED_ORG = re.compile(r"https://dev\.azure\.com/[^/\"\\\s]+/")


def rig_seed(seed, offset, to):
    """The seed as this env's board serves it: its cards moved up by `offset` (offset_seed) and
    every dev.azure.com link in it (attachments in a card's text) on the rig board's own org, so
    `abe card images` takes them as the board's attachments."""
    if offset:
        seed = offset_seed(seed, offset, to)
    write(to, SEED_ORG.sub(f"https://dev.azure.com/{RIG_ORG}/", seed.read_text()))
    return to


def offset_seed(seed, offset, to):
    """The seed with every card's number (and parent) moved up by `offset`, so two testers' boards
    number their cards apart (A 1xx, B 2xx) and a card of one showing in the other is plain."""
    if offset < 0:
        die("--seed-offset is 0 or more")
    js = json.loads(seed.read_text())
    for item in js.get("items", []):
        item["id"] += offset
        if item.get("parent") is not None:
            item["parent"] += offset
    write(to, json.dumps(js, indent=1, ensure_ascii=False) + "\n")
    return to


LOCAL = Path(os.environ.get("QARIG_LOCAL", HERE / "qarig.local.toml"))  # the gate's accounts: untracked


def gate_config():
    """The release gate's accounts and orgs (only --real reads them), from LOCAL (gitignored; copy
    qarig.local.example.toml): `org` (the GitHub org the repo copies go in, you a member),
    `source` (the gate's product repo: main and its .abe pack), `org_infra` (the org's
    infrastructure repo: terraform/org.yaml names the org store's account), `aws_profile` and
    `aws_region` (where the env's boxes live)."""
    import tomllib

    if not LOCAL.exists():
        die(f"up --real needs {LOCAL} (copy {HERE / 'qarig.local.example.toml'} and fill it in)")
    cfg = tomllib.loads(LOCAL.read_text())
    missing = [k for k in ("org", "source", "org_infra", "aws_profile", "aws_region") if not cfg.get(k)]
    if missing:
        die(f"{LOCAL}: no {', '.join(missing)}")
    return cfg


def gate_slug(org):
    """A gate env's repo copy: <org>/gate-<name>-<4hex> (down deletes only such a repo)."""
    return re.compile(rf"{re.escape(org)}/gate-[A-Za-z0-9_-]+-[0-9a-f]{{4}}")
REAL_TOOLS = ("gh", "aws", "claude", "git")
# the org store (the org infrastructure's terraform/org-store: abe-org-store-<tooling account>); a gate env gets
# its own prefix in it, gate/<name>-<4hex> (the repo copy's hex), and down deletes only that
GATE_STORE = re.compile(r"s3://abe-org-store-[0-9]{12}/gate/[A-Za-z0-9_-]+-[0-9a-f]{4}")
GATE_OVERRIDE = "  limits.maxBoxesPerPerson:\n    value: 6\n    reason: release gate (two testers' boxes count against one owner)\n"


def real_gh(*args, check=True, cwd=None):
    """gh as you, where your login lives (never a copy of it; nothing printed)."""
    env = {k: v for k, v in os.environ.items() if not k.startswith(("GH_", "GITHUB_"))}
    env["HOME"] = REAL_HOME
    p = subprocess.run(["gh", *args], capture_output=True, text=True, env=env, cwd=cwd)
    if check and p.returncode != 0:
        die(f"gh {' '.join(args[:3])}: {p.stderr.strip()[-300:]}")
    return p


def gate_store(org_infra, name, hexid):
    """The env's org store: its own prefix in the org's bucket, whose account is the org
    infrastructure's terraform/org.yaml `tooling.account` (terraform/org-store's abe-org-store-<account>)."""
    yaml = Path(org_infra) / "terraform/org.yaml"
    m = re.search(r"^tooling:\n(?:[ \t]+.*\n)*?[ \t]+account:[ \t]*\"?([0-9]{12})\"?", yaml.read_text() if yaml.exists() else "", re.M)
    if not m:
        die(f"up --real: no tooling.account in {yaml}: no org store for the env")
    url = f"s3://abe-org-store-{m.group(1)}/gate/{name}-{hexid}"
    if not GATE_STORE.fullmatch(url):
        die(f"up --real: {url} is no gate prefix of the org store")
    return url


def gate_layer(store):
    """Yours on this Mac for the env: its org store prefix (a factory key there is not read)."""
    return f"stores.org: {store}\n"


def real_aws(rig, *args):
    """aws as you on the env's profile and region (qarig.local.toml), where your SSO cache lives."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("AWS_")}
    env.update(HOME=REAL_HOME, AWS_PROFILE=rig["extra_env"]["AWS_PROFILE"], AWS_REGION=rig["extra_env"].get("AWS_REGION", ""))
    found = shutil.which("aws", path=":".join(rig.get("real_dirs") or [])) or "aws"
    return subprocess.run([found, *args], capture_output=True, text=True, env=env)


def down_store(d, rig, aws=real_aws):
    """The env's org store prefix deleted: only a gate/<name>-<4hex>/ prefix, never the bucket."""
    url = rig.get("org_store")
    if not url:
        return True
    if not GATE_STORE.fullmatch(url):
        print(f"qarig: {d.name}'s rig.json names the org store {url!r}, no gate prefix: left alone", file=sys.stderr)
        return True
    p = aws(rig, "s3", "rm", f"{url}/", "--recursive", "--only-show-errors")
    if p.returncode != 0:
        print(f"qarig: {url}/ NOT emptied ({(p.stderr or p.stdout).strip()[-200:]}): qarig down {d.name} again", file=sys.stderr)
        return False
    print(f"deleted {url}/")
    rig["org_store"] = None
    save(d, rig)
    return True


def up_real(a, d):
    """A real tester env (#232): its own private copy of the gate repo on GitHub, your gh / aws /
    claude logins where they live, a gate Override of limits.maxBoxesPerPerson, the demo board as the local fake on the repo's own seed. Boxes are
    made by the app's own Launch; down deletes the env's boxes and the repo copy."""
    cfg = gate_config()
    org = cfg["org"]
    who = real_gh("api", "user", "-q", ".login", check=False)
    if who.returncode != 0 or not who.stdout.strip():
        die("up --real needs your gh login (gh auth login under your own HOME)")
    login = who.stdout.strip()
    member = real_gh("api", f"orgs/{org}/memberships/{login}", "-q", ".state", check=False)
    if member.stdout.strip() != "active":
        die(f"up --real: gh's login {login} is no active member of {org}: no repo copy made")
    dirs = []
    for tool in REAL_TOOLS:
        found = shutil.which(tool, path=":".join(x for x in os.environ.get("PATH", "").split(":") if not shim_dir(x)) + ":/opt/homebrew/bin:/usr/local/bin:" + f"{REAL_HOME}/.local/bin")
        if not found:
            die(f"up --real: no {tool} on PATH")
        if str(Path(found).parent) not in dirs:
            dirs.append(str(Path(found).parent))
    hexid = os.urandom(2).hex()
    slug = f"{org}/gate-{a.name}-{hexid}"
    rig = {
        "version": RIG_VERSION,
        "name": a.name,
        "real": True,
        "gh_repo": slug,
        "path": str(d),  # the clone's, once made
        "abe_bin": str(ABE_BIN),
        "ado_port": free_port(),
        "seed_offset": a.seed_offset,
        "real_dirs": dirs,
        # boxes live in the gate's own account (qarig.local.toml; never a work profile)
        "extra_env": {"QARIG_DIR": str(d), "AWS_PROFILE": os.environ.get("QARIG_AWS_PROFILE", cfg["aws_profile"]), "AWS_REGION": cfg["aws_region"]},
    }
    save(d, rig)  # down finds the repo copy even if a step below gives up
    # your logins where they live, never copied: gh, aws and claude run under your own HOME (their
    # keychain items and SSO cache are found by it); the files serve itself reads are links
    for name in (".aws", ".claude.json"):
        if (Path(REAL_HOME) / name).exists():
            (d / "home" / name).symlink_to(Path(REAL_HOME) / name)
    for tool in ("gh", "aws", "claude"):
        found = shutil.which(tool, path=":".join(dirs))
        board = {k: abe_env(d, rig)[k] for k in ("ABE_ADO_BASE_URL", "ABE_LOGIN_PATH")}  # a serve it starts reads the env's board
        pins = " ".join(f"{k}={sh_quote(v)}" for k, v in {**pinned_env(d, rig), **board}.items() if k.startswith(("ABE_", "QARIG_", "VIMSTORM_")))
        write(
            d / f"bin/{tool}",
            f"#!/bin/sh\n# qarig --real: {tool} as you, where your login lives; the env's Abe dirs pinned, so an abe\n"
            f"# it starts never meets your own state or serve; a session's own socket in the env's state\n"
            f"# is kept (its hooks answer there)\n_qs=\"$ABE_SOCKET\"\nexport {pins}\n"
            f"case \"$_qs\" in {sh_quote(str(d))}/s/sessions/*|/private{sh_quote(str(d))}/s/sessions/*) ABE_SOCKET=\"$_qs\" ;; esac\n"
            f"HOME={sh_quote(REAL_HOME)} exec {sh_quote(found)} \"$@\"\n",
            0o755,
        )
    write(
        d / "home/.gitconfig",
        "[user]\n\tname = QA Rig\n\temail = qa@example.test\n[init]\n\tdefaultBranch = main\n"
        f"[credential \"https://github.com\"]\n\thelper =\n\thelper = !{d / 'bin/gh'} auth git-credential\n",
    )
    write(d / "bin/az", AZ, 0o755)  # the board stays the fake Azure DevOps (its token is fake)
    for tool in ("copilot", "codex"):
        write(d / f"bin/{tool}", f"#!/bin/sh\necho \"qarig: no {tool} in a rig env\" >&2\nexit 1\n", 0o755)
    repo = d / "repo"
    real_gh("repo", "create", slug, "--private", "--description", f"Release gate copy of {cfg['source']} for qarig env {a.name}: deleted by qarig down")
    real_gh("repo", "clone", cfg["source"], str(repo), "--", "-q", "--single-branch", "--branch", "main")
    g = lambda *c: subprocess.run(["git", *c], cwd=repo, check=True, capture_output=True, env=abe_env(d, rig))
    g("remote", "set-url", "origin", f"https://github.com/{slug}.git")
    g("push", "-q", "-u", "origin", "main")
    real_gh("repo", "edit", slug, "--enable-auto-merge", "--delete-branch-on-merge")
    gate_local(repo)
    real_gh("repo", "clone", cfg["org_infra"], str(d / "org-infra"), "--", "-q", "--depth", "1")
    rig["org_store"] = gate_store(d / "org-infra", a.name, hexid)
    save(d, rig)  # down empties the prefix even if a step below gives up
    seed = Path(a.seed).resolve() if a.seed else repo / "board/seed.json"
    if not seed.exists():
        die(f"no seed {seed}")
    if a.seed_offset:
        seed = offset_seed(seed, a.seed_offset, d / "seed.json")
    write(d / "cfg/settings.yaml", gate_layer(rig["org_store"]))
    rig.update({"path": real(repo), "seed": str(seed)})
    save(d, rig)
    start_env(d, rig)
    print(f"# real: {slug}, logins in place (gh, aws, claude), Override limits.maxBoxesPerPerson 6, org store {rig['org_store']}/", file=sys.stderr)


def gate_local(repo):
    """Yours for the env's repo, where ADR 0030 reads a factory key: the gate Override, out of git
    as Abe keeps it."""
    write(repo / ".abe/settings.local.yaml", f"# qarig --real: yours for the repo, the gate Override\noverrides:\n{GATE_OVERRIDE}")
    exclude = repo / ".git/info/exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    if ".abe/settings.local.yaml" not in (exclude.read_text() if exclude.exists() else "").splitlines():
        with open(exclude, "a") as f:
            f.write(".abe/settings.local.yaml\n")


def down_real(d, rig):
    """A real env's boxes deleted (its repo copy goes, so they could never be used again), the
    repo copy deleted, then its org store prefix (kept while a box or the copy is)."""
    slug = rig.get("gh_repo")
    if not slug:
        down_store(d, rig)
        return
    if not gate_slug(gate_config()["org"]).fullmatch(slug):
        print(f"qarig: {d.name}'s rig.json names {slug!r}, no gate copy: left alone", file=sys.stderr)
        return
    if Path(rig.get("path", "")).is_dir():
        try:
            ensure_serve(d, rig)  # its boxes are listed by its own serve
        except SystemExit:
            print(f"qarig: {d.name}'s serve did not start", file=sys.stderr)
        try:
            listed = abe(d, rig, "box", "list", check=False, json_out=True, timeout=120)
        except subprocess.TimeoutExpired:
            listed = {}
        boxes = (listed.get("data") or {}).get("boxes")  # abe --json answers {ok, data}
        if (listed.get("error") or {}).get("code") == "boxes-off":
            boxes = []  # serve.target local: no box of it can exist
        if boxes is None:
            print(f"qarig: could not list {d.name}'s boxes: {slug} kept so a box of it is not lost; qarig down {d.name} again", file=sys.stderr)
            return
        for b in boxes or []:
            if b.get("repo") == slug and b.get("state") not in ("terminated", "shutting-down"):
                t = abe(d, rig, "box", "terminate", b["name"], "--yes", check=False, timeout=300)
                print(f"box {b['name']}: {'terminated' if t.returncode == 0 else 'NOT terminated: ' + (t.stderr or t.stdout).strip()[-200:]}")
    if real_gh("repo", "view", slug, "--json", "name", check=False).returncode == 0:
        gone = real_gh("repo", "delete", slug, "--yes", check=False)
        if gone.returncode != 0:
            print(f"qarig: {slug} NOT deleted ({gone.stderr.strip()[-200:]}): qarig down {d.name} again", file=sys.stderr)
            return
        print(f"deleted {slug}")
    rig["gh_repo"] = None
    save(d, rig)
    down_store(d, rig)


def env_text(d, rig):
    env = abe_env(d, rig)
    keys = ["ABE_BIN", "ABE_STATE_DIR", "ABE_SOCKET", "ABE_CONFIG_DIR", "ABE_ADO_BASE_URL", "ABE_LOGIN_PATH", "ABE_OWNER", "VIMSTORM_NO_INSTANCE", "QARIG_NAME", "QARIG_DIR"]
    lines = [f"export {k}={sh_quote(env[k])}" for k in keys if k in env]  # a real env has no ABE_OWNER
    lines.append(f"export PATH={sh_quote(env['PATH'])}")
    lines.append(f"# the serve's HOME (claude's transcripts, .claude.json): {serve_home(d, rig)}")
    lines.append(f"# abe as this env: HOME={d / 'home'} $ABE_BIN <command>, or qarig abe {d.name} <command>")
    return "\n".join(lines) + "\n"


def print_env(d, rig):
    print(env_text(d, rig), end="")


def cmd_env(a):
    d = env_dir(a.name)
    print_env(d, load(d))


def cmd_abe(a):
    d = env_dir(a.name)
    rig = load(d)
    p = subprocess.run([rig["abe_bin"], *a.args], env=abe_env(d, rig), cwd=rig["path"])
    sys.exit(p.returncode)


def cmd_down(a, quiet=False):
    d = env_dir(a.name)
    if not (d / "rig.json").exists():
        if not quiet:
            die(f"no env {a.name}")
        return
    rig = load(d, fixed=False)
    stop_live(d, rig)
    if rig.get("real"):
        down_real(d, rig)
    try:
        abe(d, rig, "serve", "stop", "--no-start", check=False, timeout=15)
    except subprocess.TimeoutExpired:
        pass
    tmux = d / "s/tmux.sock"
    if tmux.exists():
        subprocess.run(["tmux", "-S", str(tmux), "kill-server"], capture_output=True)
    for key in ("serve_pgid", "ado_pgid"):
        pgid = rig.get(key)
        if pgid and alive(pgid) and ours(pgid):
            try:
                os.killpg(pgid, signal.SIGTERM)
            except ProcessLookupError:
                pass
    # a serve on the env's state qarig did not start (the app's bridge, a session's abe): only by its
    # state or socket, never another serve
    for pid, x in env_serves(d).items():
        try:
            os.kill(pid, signal.SIGTERM)
            print(f"stopped {d.name}'s serve pid {pid}")
        except ProcessLookupError:
            pass
    rig["ado_pgid"] = rig["serve_pgid"] = 0
    save(d, rig)
    if not quiet:
        print(f"down: {a.name} (files kept in {d}; rm -r it to drop them)")


def cmd_ls(a):
    if not ROOT.exists():
        return
    for d in sorted(ROOT.iterdir()):
        f = d / "rig.json"
        if not f.exists():
            continue
        rig = json.loads(f.read_text())
        state = "up" if alive(rig.get("ado_pgid", 0)) else "down"
        if rig.get("version", 1) < RIG_VERSION:
            state += " OLD: re-make (down, up)"
        serve = "serve up" if (d / "s/s.sock").exists() and alive(rig.get("serve_pgid", 0) or 0) else "serve auto"
        live = "live" if alive(rig.get("live_pgid", 0)) else "-"
        print(f"{d.name:16} {state:5} board :{rig['ado_port']:<6} {serve:10} {live:4} {rig['path']}")


def live_apps():
    """(env name, the binary it runs) of each live app under ROOT (any checkout's build: envs of
    other checkouts' qarigs share ROOT; an env from before live_bin counts as this build's)."""
    out = []
    for d in sorted(ROOT.iterdir()) if ROOT.exists() else []:
        try:
            rig = json.loads((d / "rig.json").read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if alive(rig.get("live_pgid", 0)):
            out.append((d.name, rig.get("live_bin", str(BIN))))
    return out


def cmd_rebuild(a):
    if lives := [n for n, bin_ in live_apps() if bin_ == str(BIN)]:
        die(f"live apps run on this build ({', '.join(lives)}): qarig quit <name> first")
    lock = build_lock(True)
    try:
        run = lambda *c, cwd=None, env=None: subprocess.run(c, cwd=cwd, env=env, check=True)
        if BUILD.resolve() == REPO.resolve():
            # QARIG_BUILD=<this checkout>: build it as it is, uncommitted changes too (never checked out)
            if a.ref:
                die("--ref builds in .scratch/qa/build; QARIG_BUILD=<this checkout> builds it as it is")
        else:
            # the ref as REPO names it (default its HEAD: what this checkout has committed)
            ref = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--verify", f"{a.ref or 'HEAD'}^{{commit}}"], capture_output=True, text=True, check=True).stdout.strip()
            if not BUILD.exists():
                BUILD.parent.mkdir(parents=True, exist_ok=True)
                run("git", "-C", str(REPO), "worktree", "add", "--detach", str(BUILD), ref)
            run("git", "-C", str(BUILD), "checkout", "-q", "--detach", ref)
        commit = subprocess.run(["git", "-C", str(BUILD), "rev-parse", "--short=8", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
        if subprocess.run(["git", "-C", str(BUILD), "status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True).stdout.strip():
            commit += "-dirty"
        env = dict(os.environ)
        env["PATH"] = f"{Path.home()}/.rustup/toolchains/stable-aarch64-apple-darwin/bin:" + env["PATH"]
        env["CARGO_TARGET_DIR"] = str(TARGET)
        env.setdefault("CARGO_BUILD_JOBS", "4")
        serial = Path(os.environ.get("QARIG_SERIAL", REPO / ".scratch/bin/serial"))  # a machine-wide build queue, if there is one
        build = [str(serial)] if serial.exists() else []
        run(*build, "cargo", "build", "--release", "--features", "shots", cwd=str(BUILD / "app"), env=env)
        run("bun", "install", "--frozen-lockfile", cwd=str(BUILD / "abe"))
        run("bun", "run", "build:darwin", cwd=str(BUILD / "abe"))
        (TARGET / "abe").mkdir(parents=True, exist_ok=True)
        tmp = ABE_BIN.with_suffix(".new")
        shutil.copy2(BUILD / "abe/dist/abe-darwin-arm64", tmp)
        os.replace(tmp, ABE_BIN)
        write(RIG / "BUILT", f"{commit}\n")
        ready = RIG / "READY"  # its first line names the commit the shared build is from; the rest stays
        rest = ready.read_text().split("\n", 1)[1] if ready.exists() and "\n" in ready.read_text() else ""
        write(ready, f"{commit}\n{rest}")
        print(f"built {commit}: {BIN} + {ABE_BIN}")
    finally:
        lock.close()


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


# ---------------------------------------------------------------- scenarios

QUESTION = {
    "question": "Which market table should the cart total read?",
    "header": "Market table",
    "multiSelect": False,
    "options": [
        {"label": "The existing market table (Recommended)", "description": "What checkout reads today"},
        {"label": "A per-market value", "description": "A new column on the market"},
    ],
}


def ask_step(q=QUESTION):
    return {"hook": "PreToolUse", "payload": {"tool_name": "AskUserQuestion", "tool_input": {"questions": [q]}}}


def answer_line(q=QUESTION, n=1):
    label = q["options"][n - 1]["label"].replace(" (Recommended)", "")
    return f'Answer to "{q["question"]}": {n} {label}'


def script_claude(d, steps, replies=None):
    """The fake claude's script for the next session started in this env (read at its start)."""
    write(d / "home/fake-claude.json", json.dumps({"steps": steps, "replies": replies or {}}, indent=1) + "\n")


def sessions(d, rig, card=None):
    data = abe(d, rig, "session", "list", json_out=True)["data"]["sessions"]
    return [x for x in data if card is None or x.get("card") == card]


def live(d, rig, card):
    return [x for x in sessions(d, rig, card) if x.get("state") not in ("ended", "stopped")]


def stop_card(d, rig, card):
    for x in live(d, rig, card):
        abe(d, rig, "session", "stop", x["id"], check=False)
    runs = abe(d, rig, "factory", "status", json_out=True, check=False)
    for r in (runs.get("data", {}) or {}).get("runs", []) if isinstance(runs, dict) else []:
        if r.get("card") == card and r.get("state") not in ("done",):
            abe(d, rig, "factory", "end", str(card), "--as", "abandoned", "--reason", "qarig: a new scenario on this card", check=False)


def launch(d, rig, card, factory):
    try:
        return _launch(d, rig, card, factory)
    except subprocess.TimeoutExpired:
        die("the launch took over 120 s: qarig abe <name> session list")


def _launch(d, rig, card, factory):
    if factory:
        return abe(d, rig, "factory", "run", str(card), "--repo", rig["path"], "--target", "local-sandbox", check=False, timeout=120)
    return abe(d, rig, "session", "launch", "--card", str(card), "--repo", rig["path"], check=False, timeout=120)


def wait_state(d, rig, card, states, secs):
    end = time.time() + secs
    while time.time() < end:
        now = live(d, rig, card)
        if now and now[0].get("state") in states:
            return now[0]
        time.sleep(0.5)
    return None


def factory_cmd(*args):
    return {"abe": ["factory", *args, "--json"]}


SCENARIOS = {}


def scenario(name, help):
    def reg(fn):
        SCENARIOS[name] = (fn, help)
        return fn

    return reg


ASK_TRIGGER = "qarig: ask now"


def asking_turn(work_ms):
    """A turn that reads a file for work_ms, then asks the question card."""
    read = {"tool_name": "Read", "tool_input": {"file_path": "src/cart.ts"}}
    return [
        {"hook": "PreToolUse", "payload": read},
        {"sleep": work_ms},
        {"hook": "PostToolUse", "payload": dict(read, tool_response={"type": "text"})},
        ask_step(),
    ]


@scenario("chat-question", "a session on --card (4) that asks a question card (Needs you in Chat): with --after ms after it starts; without, when `qarig scenario <name> ask` types its trigger (exact timing: run that from the shot's keys, see the README). --factory: as a Factory run")
def sc_chat_question(d, rig, o):
    stop_card(d, rig, o.card)
    steps = [{"say": "Read the card. Say the word and I look at the cart."}]
    if o.after:
        steps = [{"sleep": o.after}] + asking_turn(1500)
    replies = {ASK_TRIGGER: asking_turn(1500), answer_line(): [{"say": "Going on with the existing market table."}]}
    script_claude(d, steps, replies)
    t0 = time.time()
    p = launch(d, rig, o.card, o.factory)
    print(p.stdout.strip().splitlines()[0] if p.stdout.strip() else p.stderr.strip())
    if wait_state(d, rig, o.card, ("waiting", "working", "idle"), 30) is None:
        print("the session did not start within 30 s", file=sys.stderr)
    when = f"~{o.after / 1000:.0f} s after the agent started" if o.after else f"on `qarig scenario {d.name} ask`"
    print(f"launched in {time.time() - t0:.1f}s; the question comes {when}")


@scenario("ask", "type the trigger into --card's chat-question session: it works 1.5 s (a Read), then asks its question card")
def sc_ask(d, rig, o):
    x = live(d, rig, o.card)
    if not x:
        die(f"no live session on card {o.card}: qarig scenario {d.name} chat-question first")
    p = abe(d, rig, "session", "send", x[0]["id"], ASK_TRIGGER, check=False)
    print(p.stdout.strip() or p.stderr.strip())


@scenario("answer", "answer --card's open question with option --option (1): the card leaves Chat, the agent goes on")
def sc_answer(d, rig, o):
    for x in live(d, rig, o.card):
        asks = abe(d, rig, "session", "asks", x["id"], json_out=True)["data"]["cards"]
        for c in asks:
            p = abe(d, rig, "session", "answer", x["id"], "--card", c["id"], "--option", str(o.option), check=False)
            print(p.stdout.strip() or p.stderr.strip())
            return
    die(f"no open question on card {o.card}")


FACTORY_SPEC = """# {title}

## Stories
1. {title}.

## Decisions
1. Keep it to the one page (over a new one: the smallest change).

## Acceptance criteria
1. It works on the demo shop
"""


@scenario("factory-stages", "a Feature run on --card (a User Story, 4) walks create-specification → to-tickets → build → checks → review → verify, the playbook's gate answered no, one step every --every ms (4000), and stops in pr at Needs you (pr needs GitHub)")
def sc_factory_stages(d, rig, o):
    stop_card(d, rig, o.card)
    w = {"sleep": o.every}
    spec, scratch = f".abe/specs/{o.card}/spec.md", f".scratch/{o.card}"
    write_step = lambda path, text: {"write": {"path": path, "text": text}}
    steps = [
        {"say": "Writing the spec."},
        write_step(spec, FACTORY_SPEC.format(title=f"Card {o.card}")),
        factory_cmd("stage-done", "create-specification", "--report", spec),
        w,
        {"say": "Cutting tickets."},
        factory_cmd("stage-done", "to-tickets"),
        w,
        {"say": "Building."},
        write_step(f"{scratch}/build.md", "# Build\n\nOne change, its tests green.\n"),
        # checks run inside it (none configured in the rig: on to review)
        factory_cmd("stage-done", "build", "--report", f"{scratch}/build.md"),
        w,
        write_step(f"{scratch}/review.md", "# Review\n\nStandards: fine. Spec: every criterion met.\n"),
        factory_cmd("review", "--findings", "0", "--report", f"{scratch}/review.md"),
        w,
        write_step(f"{scratch}/verify.md", "# Verify\n\n1. The demo shop: it works\n"),
        factory_cmd("verify", "--phase", "after", "--result", "pass", "--report", f"{scratch}/verify.md"),
        w,
        # the playbook's gate: no manual steps, so the run goes on to pr
        factory_cmd("judge", "--answer", "no", "--reason", "the diff needs no manual steps after merge"),
        w,
        factory_cmd("needs-you", "--reason", "the pull request needs GitHub (the rig has none)"),
        {"say": "Waiting for you."},
    ]
    script_claude(d, steps)
    p = launch(d, rig, o.card, True)
    print(p.stdout.strip() or p.stderr.strip())


@scenario("needs-you", "a Factory run on --card that, after --after ms (3000) in its first step, needs you with a reason")
def sc_needs_you(d, rig, o):
