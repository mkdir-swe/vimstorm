    {
      "kind": "SettingsPage",
      "id": "settings:page",
      "props": {
        "crumbs": [
          "Abe",
          "Boxes & cloud"
        ],
        "scope": "demo-shop",
        "reveal": "settings:group:1"
      },
      "children": [
        {
          "kind": "SettingsGroup",
          "id": "settings:group:0",
          "props": {
            "caption": "Boxes"
          },
          "children": [
            {
              "kind": "SettingRow",
              "id": "settings:line:0",
              "props": {
                "label": "Max boxes per person",
                "control": {
                  "kind": "field",
                  "text": "3",
                  "size": "number"
                },
                "source": {
                  "text": "built-in"
                },
                "scope": "local"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:1",
              "props": {
                "label": "Start size",
                "control": {
                  "kind": "combo",
                  "value": "4 CPUs, 16 GB (m8g.xlarge)"
                },
                "help": "a repo's new box · within the largest",
                "source": {
                  "text": "built-in"
                },
                "scope": "local"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:2",
              "props": {
                "label": "Box size",
                "control": {
                  "kind": "combo",
                  "value": "4 CPUs, 16 GB (m8g.xlarge)"
                },
                "help": "the largest size one box may have",
                "source": {
                  "text": "Repo · 5 choices greyed, larger than the repo's largest box, m8g.xlarge"
                },
                "scope": "local",
                "default": "8 CPUs, 32 GB (m8g.2xlarge)"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:3",
              "props": {
                "label": "Largest disk",
                "control": {
                  "kind": "field",
                  "text": "300",
                  "size": "number",
                  "unit": "GB"
                },
                "help": "a box disk grows by itself up to this",
                "source": {
                  "text": "Repo"
                },
                "scope": "local",
                "default": "200"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:4",
              "props": {
                "label": "Idle stop",
                "control": {
                  "kind": "field",
                  "text": "30",
                  "size": "number",
                  "unit": "min"
                },
                "help": "with nothing running",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:5",
              "props": {
                "label": "Waiting on you",
                "control": {
                  "kind": "field",
                  "text": "120",
                  "size": "number",
                  "unit": "min"
                },
                "help": "a box stays up for a session waiting on you",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours"
              }
            }
          ]
        },
        {
          "kind": "SettingsGroup",
          "id": "settings:group:1",
          "props": {
            "caption": "Your environment"
          },
          "children": [
            {
              "kind": "SettingRow",
              "id": "settings:line:6",
              "props": {
                "label": "AWS profile",
                "control": {
                  "kind": "combo",
                  "value": "none · the default profile"
                },
                "help": "$ABE_BOX_PROFILE wins · $AWS_PROFILE, else the default profile, when empty",
                "source": {
                  "text": "built-in"
                },
                "scope": "local"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:7",
              "props": {
                "label": "AWS region",
                "control": {
                  "kind": "combo",
                  "value": "none · the profile's own"
                },
                "help": "$AWS_REGION or $AWS_DEFAULT_REGION wins · the profile's own when empty",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:8",
              "props": {
                "label": "Box owner",
                "control": {
                  "kind": "secret",
                  "set": false,
                  "editing": true,
                  "typed": 7
                },
                "help": "your GitHub login on your boxes · $ABE_OWNER wins · gh's when empty",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours",
                "hint": "⏎ change for me · yours alone: not for the repo",
                "focused": true
              }
            }
          ]
        },
        {
          "kind": "SettingsGroup",
          "id": "settings:group:2",
          "props": {
            "caption": "Stores"
          },
          "children": [
            {
              "kind": "SettingRow",
              "id": "settings:line:9",
              "props": {
                "label": "Session logs",
                "control": {
                  "kind": "field",
                  "text": "",
                  "size": "free"
                },
                "help": "file://<dir> or s3://<bucket> · $ABE_LOG_STORE wins",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours"
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:10",
              "props": {
                "label": "Prototypes and Sheets",
                "control": {
                  "kind": "field",
                  "text": "",
                  "size": "free"
                },
                "help": "the store they are kept in · file://<dir> or s3://<bucket> · $ABE_ORG_STORE wins",
                "source": {
                  "text": "built-in"
                },
                "scope": "yours"
              }
            }
          ]
        }
      ]
    }
