            "depth": 1
          },
          {
            "id": "settings:tree:editor",
            "label": "Editor",
            "depth": 0,
            "fold": "open"
          },
          {
            "id": "settings:tree:editor-general",
            "label": "General",
            "depth": 1
          },
          {
            "id": "settings:tree:editor-font",
            "label": "Font",
            "depth": 1
          },
          {
            "id": "settings:tree:color-scheme",
            "label": "Color scheme",
            "depth": 1
          },
          {
            "id": "settings:tree:vim",
            "label": "Vim",
            "depth": 1
          },
          {
            "id": "settings:tree:abe",
            "label": "Abe",
            "depth": 0,
            "fold": "open"
          },
          {
            "id": "settings:tree:agents",
            "label": "Agents & models",
            "depth": 1,
            "selected": true
