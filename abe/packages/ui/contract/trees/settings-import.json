    {
      "kind": "SettingsPage",
      "id": "settings:page",
      "props": {
        "crumbs": [
          "Appearance & Behavior",
          "Import config"
        ],
        "scope": "into your Layer",
        "reveal": "settings:group:0"
      },
      "children": [
        {
          "kind": "SettingsGroup",
          "id": "settings:group:0",
          "props": {
            "caption": "From"
          },
          "children": [
            {
              "kind": "SettingRow",
              "id": "settings:line:0",
              "props": {
                "label": "VS Code",
                "control": {
                  "kind": "value",
                  "text": "1 of 2 settings matches"
                },
                "source": {
                  "text": "~/Library/Application Support/Code/User/settings.json read"
                },
                "hint": "⏎ read what it would bring · nothing is written",
                "focused": true
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:1",
              "props": {
                "label": "WebStorm",
                "control": {
                  "kind": "value",
                  "text": "not read"
                },
                "source": {
                  "text": "its settings, keys and theme, as they become ours"
                }
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:2",
              "props": {
                "label": "Vim / Neovim",
                "control": {
                  "kind": "value",
                  "text": "not read"
                },
                "source": {
                  "text": "its settings, keys and theme, as they become ours"
                }
              }
            }
          ]
        },
        {
          "kind": "SettingsGroup",
          "id": "settings:group:1",
          "props": {
            "caption": "What it brings",
            "note": "ticked: a match here"
          },
          "children": [
            {
              "kind": "SettingRow",
              "id": "settings:line:3",
              "props": {
                "label": "editor.fontSize: 14",
                "control": {
                  "kind": "checkbox",
                  "on": true
                },
                "source": {
                  "text": "→ Editor font size = 14"
                }
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:4",
              "props": {
                "label": "editor.minimap.enabled: false",
                "control": {
                  "kind": "checkbox",
                  "on": false,
                  "fixed": true
                },
                "source": {
                  "text": "no match here"
                }
              }
            },
            {
              "kind": "SettingRow",
              "id": "settings:line:5",
              "props": {
                "label": "Import 1 setting",
                "control": {
                  "kind": "value",
                  "text": "⏎"
                },
                "source": {
                  "text": "into yours only; Problems shows what it refuses"
                }
              }
            }
          ]
        }
      ]
    }
  ]
